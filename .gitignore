# travel with the repository like the rest of it (SPEC-AGENTS.md, START.md,
# docs/spec-agents/).  They live here rather than in the repo-root skills/
# because that directory is superchat's own bundled Agentic Skills directory.
!.claude/skills/
.omc/
.omo/
.pi/
.pi-subagents/
