;;;; While it is written ---------------------------------------------------------------

(ert-deftest timer-brief/emacs-exiting-while-it-writes-says-it-again-next-time ()
  ;; The trap: with the result written before the note, the next time would
  ;; compare equal and the change would be lost.
  (wtimer--with '((:text "FIRST NOTE") (:hang t) (:text "SAID AGAIN")) (p)
    (let* ((view (tcmd--view p))
           (timer (tbrief--set (hm--session view) "STARS" (tcmd--reading p "120") 86400))
           (id (plist-get timer :id)))
      (tcmd--counter p "123")
      (tbrief--started timer)
      (should (= 1 (length (tcmd--results timer))))
      ;; A new Emacs: the execution went with the old one, and nothing knows of it.
      (let ((run (plist-get (gethash id superchat-timer--writing) :run)))
        (remhash id superchat-timer--writing)
        (superchat-runtime-cancel run))
      (tbrief--runs-over)
      (tbrief--fire timer)
      (should (equal "changed" (tcmd--status (car (last (tcmd--results timer))))))
      (should (equal "SAID AGAIN" (plist-get (tbrief--last-line timer) :text)))
      (should (= 1 (tcmd--count))))))

