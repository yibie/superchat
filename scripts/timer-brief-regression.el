(ert-deftest timer-brief/the-whole-note-and-its-tokens-are-on-record ()
  (wtimer--with '((:text "FIRST NOTE")
                  (:chunks ((:input-tokens 120 :output-tokens 30))
                   :text "LINE ONE\nLINE TWO"))
      (p)
    (let* ((view (tcmd--view p))
           (timer (tbrief--set (hm--session view) "STARS" (tcmd--reading p "120") 86400)))
      (tcmd--counter p "123")
      (tbrief--fire timer)
      (let ((result (tbrief--last-result timer)))
        (should (equal "LINE ONE\nLINE TWO" (plist-get result :note)))
        (should (= 120 (plist-get result :note-input-tokens)))
        (should (= 30 (plist-get result :note-output-tokens)))
        ;; And what it was written from.
        (should (string-search "123" (plist-get result :output))))
      (should (equal "LINE ONE" (plist-get (tbrief--last-line timer) :text))))))

