(ert-deftest timer-brief/a-long-output-is-cut-and-the-model-is-told ()
  (wtimer--with '((:text "FIRST NOTE")) (p)
    (let ((view (tcmd--view p)))
      (tbrief--set (hm--session view) "STARS"
                   (format "yes x | head -c %d" (* 2 superchat-timer-command-output-bytes))
                   86400)
      (let ((user (tbrief--text (nth 1 (car hm--wires)))))
        (should (< (length user) (+ superchat-timer-command-output-bytes 2000)))
        (should (string-match-p
                 (format "first %d of %d bytes"
                         superchat-timer-command-output-bytes
                         ;; What is compared has no newline at its end.
                         (1- (* 2 superchat-timer-command-output-bytes)))
                 user))))))

