;;;; The program decides -----------------------------------------------------------

(ert-deftest timer-brief/the-program-decides-and-the-model-writes ()
  (wtimer--with '((:text "FIRST NOTE") (:text "STARS ROSE BY THREE")) (p)
    (let* ((view (tcmd--view p))
           (timer (tbrief--set (hm--session view) "STARS" (tcmd--reading p "120") 86400)))
      (should (= 1 (length hm--wires)))
      (tcmd--counter p "123")
      (tbrief--fire timer)
      (should (= 2 (length hm--wires)))
      (should (equal "changed" (tcmd--status (car (last (tcmd--results timer))))))
      (let ((line (tbrief--last-line timer)))
        (should (string-match-p "changed" (plist-get line :ending)))
        (should (string-match-p "the model's words" (plist-get line :ending)))
        (should (equal "STARS ROSE BY THREE" (plist-get line :text)))))))

