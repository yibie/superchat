(defun tbrief--timer-row (timer)
  (cl-find (plist-get timer :id) (superchat-pending-items)
           :key (lambda (item) (plist-get item :key)) :test #'equal))

(ert-deftest timer-brief/the-row-of-a-timer-says-how-it-has-been-going ()
  ;; No news must not look like nothing having been checked.
  (wtimer--with '((:chunks ((:input-tokens 100 :output-tokens 20)) :text "FIRST NOTE")
                  (:chunks ((:input-tokens 200 :output-tokens 30)) :text "A NOTE"))
      (p)
    (let* ((view (tcmd--view p))
           (timer (tbrief--set (hm--session view) "STARS" (tcmd--reading p "120") 86400)))
      (tbrief--fire timer)
      (tcmd--counter p "123")
      (tbrief--fire timer)
      (tbrief--fire timer)
      (let ((detail (plist-get (tbrief--timer-row timer) :detail)))
        (should (string-match-p "ran 4 times" detail))
        (should (string-match-p "no change" detail))
        (should (string-match-p "1 change" detail))
        (should (string-match-p "2 notes" detail))
        (should (string-match-p "350 tokens" detail))))))

