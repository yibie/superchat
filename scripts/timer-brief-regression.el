(ert-deftest timer-brief/cancelling-one-still-queued-sends-nothing ()
  (wtimer--with '((:text "FIRST NOTE") (:text "FIRST NOTE") (:hang t)
                  (:text "MUST NOT BE ASKED FOR"))
      (p)
    (let* ((view (tcmd--view p))
           (session (hm--session view))
           (command (tcmd--reading p "120"))
