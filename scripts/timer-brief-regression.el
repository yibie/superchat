;;;; When the model does not write ------------------------------------------------------

(ert-deftest timer-brief/a-note-that-fails-leaves-the-program-s-line ()
  (wtimer--with '((:text "FIRST NOTE") (:error (error . "BOOM-FROM-THE-SERVER"))) (p)
    (let* ((view (tcmd--view p))
           (timer (tbrief--set (hm--session view) "STARS" (tcmd--reading p "120") 86400))
           (lines (length (tcmd--lines timer))))
      (tcmd--counter p "123")
      (tbrief--fire timer)
      (should (= (1+ lines) (length (tcmd--lines timer))))
      (should (= 1 (tcmd--count)))
      (let ((line (tbrief--last-line timer)))
        (should (string-match-p "no note" (plist-get line :ending)))
        (should (equal "123 (was 120)" (plist-get line :text))))
      (should (equal "changed" (tcmd--status (car (last (tcmd--results timer))))))
      (should (string-match-p "BOOM" (format "%s" (plist-get (tbrief--last-result timer)
                                                             :note-failed))))
      ;; It says so where the output can be read.
      (with-current-buffer (superchat-butler-show (plist-get (tbrief--last-line timer) :run))
        (should (string-match-p "No note from the model: .*BOOM" (buffer-string)))
        (should (string-search "123" (buffer-string)))))))

(ert-deftest timer-brief/a-lost-execution-leaves-the-program-s-line-and-frees-the-timer ()
  ;; Otherwise each time after this would be skipped, for as long as Emacs runs.
  (wtimer--with '((:text "FIRST NOTE")) (p)
    (let* ((view (tcmd--view p))
           (timer (tbrief--set (hm--session view) "STARS" (tcmd--reading p "120") 86400))
           (lines (length (tcmd--lines timer)))
           (orig (symbol-function 'superchat-service-call))
           sink)
      (tcmd--counter p "123")
      (cl-letf (((symbol-function 'superchat-service-call)
                 (lambda (scope service operation &rest args)
                   (if (and (eq service 'driver) (eq operation 'submit))
                       (progn (setq sink (plist-get (car args) :sink))
                              (list :status 'accepted :run-id "no-such-run"))
                     (apply orig scope service operation args)))))
        (superchat-timer-fire timer (superchat-timer--now))
        (tcmd--settled))
      (should (tbrief--writing-p timer))
      (superchat-sink-emit sink 'orphaned (list :run-id "no-such-run") 'sink-lost)
      (should-not (tbrief--writing-p timer))
      (should (= (1+ lines) (length (tcmd--lines timer))))
      (should (string-match-p "no note" (plist-get (tbrief--last-line timer) :ending))))))

