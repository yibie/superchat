;;; timer-brief-regression.el --- the program decides, the model writes -*- lexical-binding: t; -*-

;;; Commentary:
;; Offline coverage for
;; docs/decisions/accepted/2026-10-31-the-program-decides-the-model-writes.md: a
;; timer's command can have a model with no tools write a few sentences about its
;; output.  Whether anything is said stays the program's: the comparison and the
;; failures in a row decide, and nothing the model answers changes that.
;;
;; The commands here are real processes run by `sh'; the model is scripted.
;;
;; Run from the repository root:
;;   emacs -Q --batch \
;;     --eval "(progn (require 'package) (setq package-user-dir \"$HOME/.cache/superchat-test-elpa\" native-comp-jit-compilation nil) (package-initialize))" \
;;     -L . -L plugins/superchat-cowork-telega \
;;     -l scripts/timer-brief-regression.el \
;;     --eval '(ert-run-tests-batch-and-exit "^timer-brief/")'

;;; Code:

(load (expand-file-name "timer-command-regression.el"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t)

(defvar tbrief--tools nil "What each scripted request offered, newest first.")

(defun tbrief--settled ()
  "Wait until no command is running and no note is being written."
  (tcmd--settled)
  (should (smoke--wait (lambda () (zerop (hash-table-count superchat-timer--writing))) 10)))

(defun tbrief--set (session text command &optional repeat report-unchanged)
  "Set a timer with a brief in SESSION, due in an hour, and wait for its first run."
  (prog1 (superchat-timer-create session 'command text (+ (superchat-timer--now) 3600)
                                 repeat command report-unchanged t)
    (tbrief--settled)))

(defun tbrief--fire (timer &optional occurrence)
  "Fire TIMER and wait for its command and its note."
  (prog1 (superchat-timer-fire timer (or occurrence (superchat-timer--now)))
    (tbrief--settled)))

(defun tbrief--last-line (timer)
  (car (last (tcmd--lines timer))))

(defun tbrief--last-result (timer)
  (plist-get (car (last (tcmd--results timer))) :payload))

(defun tbrief--text (message)
  (alist-get 'content message))

(defun tbrief--writing-p (timer)
  (and (gethash (plist-get timer :id) superchat-timer--writing) t))

(defun tbrief--started (timer)
  "Run TIMER's command and wait until its note is being written: it may hang."
  (superchat-timer-fire timer (superchat-timer--now))
  (tcmd--settled)
  (should (tbrief--writing-p timer)))

(defun tbrief--runs-over ()
  (should (smoke--wait (lambda () (null (superchat-runtime-active-runs))) 10)))

;;;; Setting one -----------------------------------------------------------------

(ert-deftest timer-brief/the-question-says-a-model-reads-the-output ()
  ;; The user is asked to allow a command.  A model reading what it prints each
  ;; time is something else to allow.
  (wtimer--with (list (tcmd--call '(text . "STARS") '(kind . "command")
                                  '(in_minutes . 60) '(repeat . "daily")
                                  '(command . "echo COMMAND-TEXT") '(brief . t))
                      '(:text "A NOTE") '(:text "finished"))
      (p)
    (tcmd--asking t
      (let ((view (tcmd--view p)))
        (hm--turn view "tell me every day in words")
        (tbrief--settled)
        (should (= 1 (length tcmd--asked)))
        (let ((reason (plist-get (car tcmd--asked) :reason)))
          (should (string-match-p "echo COMMAND-TEXT" reason))
          (should (string-match-p "model" reason))
          (should (string-match-p "no tools" reason)))))))

(ert-deftest timer-brief/without-it-the-question-does-not-mention-a-model ()
  (wtimer--with (list (tcmd--call '(text . "STARS") '(kind . "command")
                                  '(in_minutes . 60) '(repeat . "daily")
                                  '(command . "echo COMMAND-TEXT"))
                      '(:text "finished"))
      (p)
    (tcmd--asking t
      (let ((view (tcmd--view p)))
        (hm--turn view "tell me every day")
        (tbrief--settled)
        (should-not (string-match-p "model"
                                    (plist-get (car tcmd--asked) :reason)))
        (should-not (plist-get (car (superchat-timer-list)) :brief))))))

