        (superchat-timer-fire timer (superchat-timer--now))
        (tcmd--settled)
        (should (= asked (length hm--wires)))
        (should (equal "skipped" (tcmd--status (car (last (tcmd--results timer))))))))))

(ert-deftest timer-brief/two-timers-each-get-their-own-note ()
  ;; One Session: the second waits for the first.  Which command ends first is
  ;; not known, so the note is matched by the request it answers.
  (wtimer--with '((:text "THE-FIRST-NOTE" :delay 0.2) (:text "THE-SECOND-NOTE")) (p)
    (let* ((view (tcmd--view p))
           (session (hm--session view))
           (due (+ (superchat-timer--now) 3600))
           (one (superchat-timer-create session 'command "CHECK-ONE" due nil "echo 1" nil t))
           (two (superchat-timer-create session 'command "CHECK-TWO" due nil "echo 2" nil t)))
      (superchat-timer-fire one (superchat-timer--now))
      (superchat-timer-fire two (superchat-timer--now))
      (tbrief--settled)
      (should (= 2 (length hm--wires)))
      (let* ((first-request (tbrief--text (nth 1 (nth 1 hm--wires))))
             (first (if (string-search "CHECK-ONE" first-request) one two))
             (second (if (eq first one) two one)))
        (should (equal "THE-FIRST-NOTE" (plist-get (tbrief--last-line first) :text)))
        (should (equal "THE-SECOND-NOTE" (plist-get (tbrief--last-line second) :text)))))))

