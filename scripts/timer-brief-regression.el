;;;; The list ------------------------------------------------------------------------

(defun tbrief--running-row ()
  (cl-find 'running (superchat-pending-items)
           :key (lambda (item) (plist-get item :kind))))

(ert-deftest timer-brief/one-that-waited-for-its-turn-can-be-named-and-stopped ()
  ;; The first ends; the second starts on its own, later than anything could say
  ;; which execution it is.
  (wtimer--with '((:text "FIRST NOTE") (:text "FIRST NOTE")
                  (:text "NOTE-OF-THE-FIRST" :delay 0.1) (:hang t))
      (p)
    (let* ((view (tcmd--view p))
           (session (hm--session view))
           (command (tcmd--reading p "120"))
           (one (tbrief--set session "ONE" command 86400))
           (two (tbrief--set session "TWO" command 86400)))
      (tcmd--counter p "123")
      (superchat-timer-fire one (superchat-timer--now))
      (superchat-timer-fire two (superchat-timer--now))
      (tcmd--settled)
      ;; Whichever command ended first, one note ends and the other hangs.
      (should (smoke--wait (lambda () (= 1 (hash-table-count superchat-timer--writing))) 10))
      (should (smoke--wait (lambda () (= 4 (length hm--wires))) 10))
      (let* ((waiting (if (tbrief--writing-p one) one two))
             (row (should (tbrief--running-row)))
             (lines (length (tcmd--lines waiting))))
        (should (string-search (plist-get waiting :text) (plist-get row :what)))
        (superchat-timer-cancel (plist-get waiting :id))
        (tbrief--runs-over)
        (should (= lines (length (tcmd--lines waiting))))))))

