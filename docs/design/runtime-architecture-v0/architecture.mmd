flowchart TB
    subgraph Surface["Surface layer (equal peers; each only builds a Request)"]
        UI["superchat.el<br/>chat buffer / C-c C-c"]
        MCP["superchat-mcp.el"]
        MAG["superchat-magit.el"]
        OB["ob-superchat.el"]
    end

    subgraph Ingress["Ingress assembly"]
        DISP["superchat-dispatcher.el<br/>parses / > >> # @ prefixes<br/>attach memories → build Request"]
        CORE["superchat-core.el<br/>Turn data + pure prompt preparation"]
        EXT["superchat-extension.el<br/>compose-request (tools/context/commands/policies)"]
    end

    subgraph Kernel["Kernel (sole owner of lifecycle and judgment)"]
        RT["superchat-runtime.el<br/>submit / status / cancel<br/>in-process Run registry (only mutable state)"]
        GUARD["Closure Guard<br/>pre-terminal full-Session replay<br/>judges ready-terminal"]
        SHADOW["Closure Shadow<br/>post-terminal cross-check<br/>(diagnostics only, cannot overturn)"]
        CLO["superchat-closure.el<br/>pure judge: proved/open/unknown/invalid"]
    end

    subgraph Transport["Transport"]
        LLM["superchat-llm.el<br/>llm.el adapter; llm runs the tool loop natively<br/>streaming via curl subprocess"]
        PROVIDER["Model Provider"]
    end

    subgraph Exec["Execution gate (every model tool call crosses it)"]
        AUTH["superchat-authority.el<br/>validate → effects → policy → approval → execute"]
        TOOLS["superchat-tools.el built-ins<br/>+ synthesized tools + MCP tools"]
    end

    subgraph Truth["Facts and derived state"]
        TAPE["superchat-tape.el<br/>logical event interface:<br/>identity / causation / redaction / replay"]
        REC["tape-recovery/<br/>0600 per-Run JSON sidecar<br/>audit-incomplete terminal pair only"]
        DB["superchat-db.el<br/>SQLite physical layer + FTS5 trigram"]
        PROJ["superchat-projection.el<br/>reducer/checkpoint seam"]
        MEM["memory table (Projection output, rebuildable)"]
        VIEWS["team / workflow-instance /<br/>workspace / session-config (pure replay)"]
    end

    subgraph Actors["Actor shapes reusing the same kernel"]
        SUB["superchat-subagent.el<br/>topology=subagent, parent-run-id"]
        WF["superchat-workflow.el<br/>Closure-gated step handoff"]
        CMP["superchat-compact.el<br/>compactor Run → anchor append"]
    end

    UI --> DISP --> CORE --> EXT --> RT
    MCP & MAG & OB --> RT
    RT --> LLM --> PROVIDER
    LLM --> AUTH --> TOOLS
    RT --> TAPE --> DB
    RT -. audit-incomplete fallback .-> REC
    REC -. reconcile before replay .-> TAPE
    AUTH --> TAPE
    GUARD --> CLO
    SHADOW --> CLO
    CLO --> TAPE
    PROJ --> DB
    MEM & VIEWS --> PROJ
    SUB & WF & CMP --> RT
