rites buffer contents\",\"args\":[{\"name\":\"buffer_name\",\"type\":\"string\",\"description\":\"Name of the buffer to overwrite\"},{\"name\":\"content\",\"type\":\"string\",\"description\":\"Content to write to the buffer\"}],\"async\":null},{\"name\":\"eshell-command\",\"description\":\"Execute an Emacs Eshell command and return its output. Use for commands such as pwd, ls, grep, find, git status, pipelines, and redirection; it supports Eshell built-ins, aliases, and external commands.\",\"args\":[{\"name\":\"command\",\"type\":\"string\",\"description\":\"The Eshell command to execute.\"}],\"async\":null},{\"name\":\"workspace_read\",\"description\":\"Read one buffer-region Artifact from the current Workspace. Cross-Run reads require the revision reported by workspace_info and are delivered only after the producer Run has a durable Closure proof.\",\"args\":[{\"name\":\"artifact_id\",\"type\":\"string\",\"description\":\"Artifact ID; omit for the active Artifact.\",\"optional\":true},{\"name\":\"expected_revision\",\"type\":\"string\",\"description\":\"Revision reported by workspace_info; required when consuming an Artifact produced by another Run.\",\"optional\":true}],\"async\":null},{\"name\":\"workspace_write\",\"description\":\"Write to a buffer-region Artifact in the current Workspace. Call workspace_info first and pass its revision when the Artifact already exists; stale revisions are rejected. When APPEND is true, content is added at the end.\",\"args\":[{\"name\":\"content\",\"type\":\"string\",\"description\":\"The content to write to the workspace.\"},{\"name\":\"append\",\"type\":\"boolean\",\"description\":\"Append to existing content instead of replacing.\",\"optional\":true},{\"name\":\"artifact_id\",\"type\":\"string\",\"description\":\"Target Artifact ID; omit for the active Artifact.\",\"optional\":true},{\"name\":\"expected_revision\",\"type\":\"string\",\"description\":\"Revision reported by workspace_info; required for an existing Artifact.\