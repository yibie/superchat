tent-format\":\"text\",\"content\":\"Work as a coding assistant. Inspect before editing, keep changes scoped, and verify them with the available build or test tools.\\n\\n\\nYou can batch INDEPENDENT read-only tool calls (read-file, list-files, search-text, find-files, lsp-references, lsp-hover, read_buffer) into a single turn.\\nTools that depend on each other's output must wait for the previous result.\\n\",\"tool-results\":[],\"multi-turn\":null},{\"role\":\"user\",\"content-format\":\"text\",\"content\":\"Your first tool call must be workspace_read, exactly once, for Artifact artifact-49461818-1 without expected_revision. Do not call workspace_info or any other tool before it. This is a read-only task: never call workspace_write, EditBuffer, ReplaceBuffer, or eshell-command. If it fails, make exactly one recovery Action using the available tools. Do not answer before that Action.\",\"tool-results\":[],\"multi-turn\":null}],\"tools\":[{\"name\":\"read-file\",\"description\":\"Reads a file, or a line slice of it. For large files, prefer reading slices (offset/limit) over the whole file — pull in only what the task needs.\",\"args\":[{\"name\":\"path\",\"type\":\"string\",\"description\":\"The path of the file to read.\"},{\"name\":\"offset\",\"type\":\"integer\",\"description\":\"1-based first line of the slice to read.\",\"optional\":true},{\"name\":\"limit\",\"type\":\"integer\",\"description\":\"Number of lines to read from offset.\",\"optional\":true}],\"async\":null},{\"name\":\"list-files\",\"description\":\"Lists files and subdirectories in a specified directory, similar to 'ls -l'. Requires user approval.\",\"args\":[{\"name\":\"path\",\"type\":\"string\",\"description\":\"The path to the directory to list. Defaults to the current directory if not provided.\",\"optional\":true}],\"async\":null},{\"name\":\"search-text\",\"description\":\"Searches for a textual pattern (or regular expression) in files. Requires user approval.\",\"args\":[{\"name\":\"pattern\",\"type\":\"string\",\"description\":\"The text or regular expression to search for.\"},{\"name\":\"path\",\"type\":\"string\",\"description\":\"The specific file or directory to search in. Defaults to the current directory if not provided.\",\"optional\":true}],\"async\":null},{\"name\":\"read_buffer\",\"description\":\"Return the contents of an Emacs buffer\",\"args\":[{\"name\":\"buffer\",\"type\":\"string\",\"description\":\"The name of the buffer whose contents are to be retrieved\"}],\"async\":null},{\"name\":\"EditBuffer\",\"description\":\"Edits Emacs buffers\",\"args\":[{\"name\":\"buffer_name\",\"type\":\"string\",\"description\":\"Name of the buffer to modify\"},{\"name\":\"old_string\",\"type\":\"string\",\"description\":\"Text to replace (must match exactly)\"},{\"name\":\"new_string\",\"type\":\"string\",\"description\":\"Text to replace old_string with\"}],\"async\":null},{\"name\":\"ReplaceBuffer\",\"description\":\"Completely overwrites buffer contents\",\"args\":[{\"name\":\"buffer_name\",\"type\":\"string\",\"description\":\"Name of the buffer to overwrite\"},{\"name\":\"content\",\"type\":\"string\",\"description\":\"Content to write to the buffer\"}],\"async\":null},{\"name\":\"eshell-command\",\"description\":\"Execute an Emacs Eshell command and return its output. Use for commands such as pwd, ls, grep, find, git status, pipelines, and redirection; it supports Eshell built-ins, aliases, and external commands.\",\"args\":[{\"name\":\"command\",\"type\":\"string\",\"description\":\"The Eshell command to execute.\"}],\"async\":null},{\"name\":\"workspace_read\",\"description\":\"Read one buffer-region Artifact from the current Workspace. Cross-Run reads require the revision reported by workspace_info and are delivered only after the producer Run has a durable Closure proof.\",\"args\":[{\"name\":\"artifact_id\",\"type\":\"string\",\"description\":\"Artifact ID; omit for the active Artifact.\",\"optional\":true},{\"name\":\"expected_revision\",\