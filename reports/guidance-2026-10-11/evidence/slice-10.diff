+        (when (and id (not (member id seen)))
+          (push id seen)
+          (let ((sessions (ignore-errors (superchat-view-workspace-session-ids id))))
+            (push (list :directory (file-name-as-directory (file-relative-name dir ts-home))
+                        :id id
+                        :root (plist-get ws :root)
+                        :sessions sessions
+                        :records
+                        (mapcar (lambda (record)
