+(defun ts-gather-print (value)
+  "VALUE printed so that `read' gives it back; an unreadable part is a string."
+  (let ((print-length nil) (print-level nil) (print-circle nil) (print-escape-newlines nil))
+    (cond ((or (stringp value) (numberp value) (symbolp value)) value)
+          ((consp value)
+           (if (proper-list-p value)
+               (mapcar #'ts-gather-print value)
+             (cons (ts-gather-print (car value)) (ts-gather-print (cdr value)))))
+          ((vectorp value) (vconcat (mapcar #'ts-gather-print value)))
+          (t (format "%S" value)))))
+
+(defun ts-gather-write (name object)
+  "Write OBJECT to evidence/gather/NAME.eld, readable by `read'."
+  (let ((dir (expand-file-name "gather/" ts-evidence)))
+    (make-directory dir t)
+    (with-temp-file (expand-file-name (concat name ".eld") dir)
+      (let ((print-length nil) (print-level nil) (print-circle nil))
+        (prin1 (ts-gather-print object) (current-buffer))))))
+
+(defun ts-gather-setup ()
+  "Write the values the task names in `:gather-setup', right after :setup."
+  (ts-gather-write "setup"
+                   (mapcar (lambda (entry) (cons (car entry) (symbol-value (cdr entry))))
+                           (ts-task-get :gather-setup))))
+
+(defun ts-gather-timer (timer)
+  "TIMER as (DUE-SECONDS IDLE FUNCTION-AND-ARGS ARGS), printed and bounded."
+  (let ((print-level 8) (print-length 200) (print-circle t))
+    (list (float-time (timer--time timer))
+          (and (timer--idle-delay timer) t)
+          (format "%S" (list (timer--function timer) (timer--args timer)))
+          (format "%S" (timer--args timer)))))
+
+(defun ts-gather-workspaces ()
+  "Every Workspace of a directory under the home, and the Personal one.
+Each: (:directory :id :root :sessions :records :events), the records as
+data with their status and rendering, the events those sessions hold of the
+Work Record and timer kinds (type and payload)."
+  (let ((dirs (cons ts-home
