+                                        :status (ignore-errors (superchat-work-status record))
+                                        :render (ignore-errors (superchat-work-render record))))
+                                (ignore-errors (superchat-work-records id)))
+                        :events
+                        (cl-loop for session in sessions
+                                 append (cl-loop for event in (ignore-errors
+                                                               (superchat-tape-replay-events session))
+                                                 when (string-match-p "\\`\\(work\\|timer\\)\\."
+                                                                      (or (plist-get event :type) ""))
+                                                 collect (list :session session
+                                                               :type (plist-get event :type)
+                                                               :payload (plist-get event :payload)))))
+                  out)))))
+    (nreverse out)))
