   549	;;;; Arming -----------------------------------------------------------------------------
   550	
   551	(defun superchat-timer--active-p ()
   552	  (and (fboundp 'superchat-plugin-row-active-p)
   553	       (superchat-plugin-row-active-p 'timers)))
   554	
   555	(defun superchat-timer--disarm (id)
   556	  (when-let* ((emacs-timer (gethash id superchat-timer--armed)))
   557	    (cancel-timer emacs-timer)
   558	    (remhash id superchat-timer--armed)))
   559	
   560	(defun superchat-timer-disarm-all ()
   561	  "Cancel every Emacs timer this module set; the facts stay on the Tape."
   562	  (maphash (lambda (_id emacs-timer) (cancel-timer emacs-timer))
   563	           superchat-timer--armed)
   564	  (clrhash superchat-timer--armed)
   565	  (when (timerp superchat-timer--retry-timer)
   566	    (cancel-timer superchat-timer--retry-timer))
   567	  (setq superchat-timer--retry-timer nil
   568	        superchat-timer--retry-at nil))
   569	
   570	(defun superchat-timer--due (id)
   571	  "The Emacs timer for ID went off: fire what is due now, arm the rest."
   572	  (remhash id superchat-timer--armed)
   573	  (when-let* ((timer (cl-find id (superchat-timer-list)
   574	                              :key (lambda (timer) (plist-get timer :id))
   575	                              :test #'equal))
   576	              (occurrence (superchat-timer--latest-occurrence
   577	                           timer (superchat-timer--now))))
   578	    (superchat-timer-fire timer occurrence)
   579	    (when-let* ((again (cl-find id (superchat-timer-list)
   580	                                :key (lambda (timer) (plist-get timer :id))
   581	                                :test #'equal)))
   582	      (superchat-timer--arm again))))
   583	
   584	(defun superchat-timer--arm (timer)
   585	  "Set an Emacs timer for TIMER's next occurrence."
   586	  (let ((id (plist-get timer :id))
   587	        (delay (max 0 (- (plist-get timer :next-due) (superchat-timer--now)))))
   588	    (superchat-timer--disarm id)
   589	    (puthash id (run-at-time delay nil #'superchat-timer--due id)
   590	             superchat-timer--armed)))
   591	
   592	(defun superchat-timer-catch-up ()
   593	  "Fire, once each, the timers that came due while nothing was armed.
   594	A repeating timer fires only its most recent missed occurrence.  Return
   595	the fired plists."
   596	  (clrhash superchat-timer--retries)
   597	  (clrhash superchat-timer--not-before)
   598	  ;; First the tasks an earlier Emacs fired and never started.
   599	  (superchat-timer-retry-tasks)
   600	  (let ((now (superchat-timer--now)) fired)
   601	    (dolist (timer (superchat-timer-list))
   602	      (when-let* ((occurrence (superchat-timer--latest-occurrence timer now)))
   603	        (push (superchat-timer-fire timer occurrence) fired)))
   604	    (nreverse fired)))
   605	
   606	(defun superchat-timer-arm-all ()
   607	  "Catch up on missed timers, then arm every pending one."
   608	  (superchat-timer-disarm-all)
   609	  (superchat-timer-catch-up)
   610	  (dolist (timer (superchat-timer-list))
   611	    (superchat-timer--arm timer)))
   612	
   613	;;;; Time -------------------------------------------------------------------------------
   614	
   615	(defun superchat-timer-format-time (time)
   616	  "TIME, seconds since the epoch, as local \"YYYY-MM-DD HH:MM\"."
   617	  (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time time)))
   618	
   619	(defun superchat-timer--repeat-name (seconds)
   620	  (or (car (rassq seconds superchat-timer-repeats))
   621	      (format "%d minutes" (/ seconds 60))))
   622	
   623	(defun superchat-timer-parse-time (at)
   624	  "Parse AT, local \"YYYY-MM-DD HH:MM\", to seconds since the epoch.
   625	Signals an error for any other shape."
   626	  (unless (and (stringp at)
   627	               (string-match "\\`\\([0-9]\\{4\\}\\)-\\([0-9]\\{2\\}\\)-\\([0-9]\\{2\\}\\)[ T]\\([0-9]\\{1,2\\}\\):\\([0-9]\\{2\\}\\)\\'"
   628	                             (string-trim at)))
   629	    (error "Time must look like 2026-10-02 08:30: %S" at))
   630	  (let ((at (string-trim at)))
   631	    (float-time
   632	     (encode-time (list 0
   633	                        (string-to-number (match-string 5 at))
   634	                        (string-to-number (match-string 4 at))
   635	                        (string-to-number (match-string 3 at))
   636	                        (string-to-number (match-string 2 at))
   637	                        (string-to-number (match-string 1 at))
   638	                        nil -1 nil)))))
   639	
   640	;;;; Tools ------------------------------------------------------------------------------
   641	
   642	(defun superchat-timer--tool-session ()
   643	  (or (and (boundp 'superchat--tool-execution-context)
   644	           (plist-get superchat--tool-execution-context :session-id))
   645	      (and (boundp 'superchat--session-id) superchat--session-id)))
   646	
   647	(defconst superchat-timer--off
   648	  "Timers are turned off in this Emacs (the timers row is not mounted)"
   649	  "What a timer tool says while nothing would fire a timer.")
   650	
   745	A timer of another Workspace is refused, pending or fired and not yet
   746	started; the user's own commands cancel any."
   747	  (let* ((session (superchat-timer--tool-session))
   748	         (by-id (lambda (timer) (equal id (plist-get timer :id))))
   749	         (timer (or (cl-find-if by-id (superchat-timer-list))
   750	                    (cl-find-if by-id (superchat-timer-unstarted-tasks)))))
   751	    (cond ((null timer) (format "Error: no pending timer %s." id))
   752	          ((not (superchat-timer--within-p session timer))
   753	           (format "Error: timer %s belongs to another workspace; this conversation cannot cancel it."
   754	                   id))
   755	          ((superchat-timer-cancel id) (format "Timer %s cancelled." id))
   756	          (t (format "Error: no pending timer %s." id)))))
   757	
   758	;;;; The row ------------------------------------------------------------------------------
   759	
   760	(superchat-define-plugin timers
   761	  :doc "Timers and reminders: every pending timer on the Tape is armed when
   762	the row mounts (missed ones fire once first) and disarmed when it unmounts."
   763	  :apply
   764	  (lambda (scope _config)
   765	    ;; After loading finishes, so a missed task never starts mid-`require'.
   766	    (let ((start (run-at-time 0 nil #'superchat-timer-arm-all)))
   767	      (superchat-scope-effect scope
   768	                              (lambda ()
   769	                                (cancel-timer start)
   770	                                (superchat-timer-disarm-all))))))
   771	
   772	(provide 'superchat-timer)
   773	;;; superchat-timer.el ends here
