   327	(defun superchat-timer--fact (session-id type timer-id occurrence &optional more)
   328	  "Append the timer fact TYPE for OCCURRENCE of TIMER-ID to SESSION-ID's Tape."
   329	  (superchat-tape-append-event
   330	   (list :type type :session-id session-id :actor-id "timers"
   331	         :summary (format "%s: %s" type timer-id)
   332	         :payload (append (list :timer-id timer-id :occurrence occurrence) more))))
   333	
   334	(defun superchat-timer--session-busy-p (session-id)
   335	  "Non-nil while an execution is running in the conversation SESSION-ID."
   336	  (cl-some (lambda (run)
   337	             (equal session-id
   338	                    (plist-get (superchat-runtime-status run) :session-id)))
   339	           (superchat-runtime-active-runs)))
   340	
   341	(defvar superchat-timer-started-functions nil
   342	  "Functions called with SESSION-ID and RUN-ID once a task's start is on record.
   343	`timer.started' is written after the send returns.  An execution may have
   344	ended by then; whoever acts on \"Superchat started this\" at the end of an
   345	execution learns it here.")
   346	
   347	(defun superchat-timer--note-started (session-id timer-id occurrence run-id)
   348	  "Record that RUN-ID is the execution of OCCURRENCE of the task TIMER-ID."
   349	  (superchat-timer--fact session-id "timer.started" timer-id occurrence
   350	                         (list :run-id run-id))
   351	  (run-hook-with-args 'superchat-timer-started-functions session-id run-id))
   352	
   353	(defun superchat-timer--start-task (session-id timer-id occurrence text)
   354	  "Start the model on TEXT in the conversation SESSION-ID; return the Run id.
   355	Return `busy', sending nothing, while an execution runs there: the message
   356	would only be queued in memory.  Otherwise record `timer.sending', send, and
   357	record `timer.started' with the Run that began; nil when none began."
   358	  (if (superchat-timer--session-busy-p session-id)
   359	      'busy
   360	    (let ((view (or (superchat-timer--live-view session-id)
   361	                    (and (fboundp 'superchat--render-session-view)
   362	                         (superchat--render-session-view session-id)))))
   363	      (when (buffer-live-p view)
   364	        (with-current-buffer view
   365	          (let ((before superchat--active-run-id))
   366	            (superchat-timer--fact session-id "timer.sending" timer-id occurrence)
   367	            (let ((inhibit-read-only t)
   368	                  (start (copy-marker (point-max))))
   369	              (goto-char (point-max))
   370	              (insert text)
   371	              (condition-case err
   372	                  ;; The timer speaks here, not the user.
   373	                  (let ((superchat-automated-input t))
   374	                    (superchat-send-input))
   375	                ;; A failed send must not leave the text for the next try.
   376	                (error (when (<= start (point-max))
   377	                         (delete-region start (point-max)))
   378	                       (signal (car err) (cdr err)))))
   379	            (let ((run superchat--active-run-id))
   380	              (when (and (stringp run) (not (equal run before)))
   381	                (superchat-timer--note-started session-id timer-id occurrence run)
   382	                run))))))))
   383	
   384	(defun superchat-timer--retry-later (seconds)
   385	  "Try the unstarted tasks again in SECONDS, or sooner when that is already set.
   386	One Emacs timer serves every unstarted task, so it is due at the soonest
   387	time any of them asked for."
   388	  (let ((at (+ (float-time) seconds)))
   389	    (when (or (not (timerp superchat-timer--retry-timer))
   390	              (not (numberp superchat-timer--retry-at))
   391	              (< at superchat-timer--retry-at))
   392	      (when (timerp superchat-timer--retry-timer)
   393	        (cancel-timer superchat-timer--retry-timer))
   394	      (setq superchat-timer--retry-at at
   395	            superchat-timer--retry-timer
   396	            (run-at-time seconds nil
   397	                         (lambda ()
   398	                           (setq superchat-timer--retry-timer nil
   399	                                 superchat-timer--retry-at nil)
   400	                           (superchat-timer-retry-tasks)))))))
   401	
   402	(defun superchat-timer--try-task (session-id timer-id occurrence text)
   403	  "Start the task and return its Run id, or nil when no execution began.
   404	A busy conversation is tried again after `superchat-timer-busy-retry-seconds'
   405	without limit; a failed start after `superchat-timer-retry-seconds', at most
   406	`superchat-timer-retry-limit' times in one Emacs.
   407	
   408	Both are checked here, before the start is tried, not only when the next
   409	try is scheduled: the one Emacs timer that retries serves every unstarted
   410	task, so a task out of tries, or one that failed a moment ago, is reached
   411	again whenever another task keeps that timer going."
   412	  (let* ((key (cons timer-id occurrence))
   413	         (failed (gethash key superchat-timer--retries 0))
   414	         (wait (- (gethash key superchat-timer--not-before 0)
   415	                  (superchat-timer--now))))
   416	    (cond
   417	     ;; Out of tries in this Emacs: it stays on record as not started.
   418	     ((> failed superchat-timer-retry-limit) nil)
   419	     ;; It failed a moment ago: its own wait is not over.
   420	     ((> wait 0) (superchat-timer--retry-later wait) nil)
   421	     (t
   422	      (let ((run (condition-case err
   423	                     (superchat-timer--start-task session-id timer-id occurrence text)
   424	                   (error (message "superchat: scheduled task %s was not started: %s"
   425	                                   timer-id (error-message-string err))
   426	                          nil))))
   427	        (cond ((stringp run)
   428	               (remhash key superchat-timer--retries)
   429	               (remhash key superchat-timer--not-before)
   430	               run)
   431	              ((eq run 'busy)
   432	               (superchat-timer--retry-later superchat-timer-busy-retry-seconds)
   433	               nil)
   434	              (t (let ((failed (1+ failed)))
   435	                   (puthash key failed superchat-timer--retries)
   436	                   (when (<= failed superchat-timer-retry-limit)
   437	                     (puthash key (+ (superchat-timer--now)
   438	                                     superchat-timer-retry-seconds)
   439	                              superchat-timer--not-before)
   440	                     (superchat-timer--retry-later superchat-timer-retry-seconds)))
   441	                 nil)))))))
   442	
   443	(defun superchat-timer-unstarted-tasks ()
   444	  "The fired tasks with no execution on record, oldest first.
   445	Each is a plist (:id :session-id :occurrence :text :sending).  Only an
   446	occurrence whose `timer.fired' fact asks for a start is counted, so tasks
   447	fired before this was recorded are left alone."
   448	  (let ((table (make-hash-table :test #'equal)) order)
   449	    (dolist (row (superchat-timer--rows))
   450	      (cl-destructuring-bind (session type payload) row
   451	        (let* ((id (superchat-timer--payload-get payload 'timer_id 'timer-id))
   452	               (key (cons id (alist-get 'occurrence payload))))
   453	          (pcase type
   454	            ("timer.fired"
   455	             (when (eq t (superchat-timer--payload-get payload 'awaits_start 'awaits-start))
   456	               (push key order)
   457	               (puthash key (list :id id :session-id session
   458	                                  :occurrence (cdr key)
   459	                                  :text (alist-get 'text payload)
   460	                                  :sending nil)
   461	                        table)))
   462	            ("timer.sending"
   463	             (when-let* ((task (gethash key table)))
   464	               (puthash key (plist-put task :sending t) table)))
   465	            ((or "timer.started" "timer.unconfirmed") (remhash key table))
   466	            ("timer.cancelled"
   467	             (dolist (k order)
   468	               (when (equal id (car k)) (remhash k table))))))))
   469	    (delq nil (mapcar (lambda (key) (gethash key table)) (nreverse order)))))
   470	
   471	(defun superchat-timer--run-after-sending-p (task)
   472	  "Non-nil when a Run began in TASK's conversation after it was last sent."
   473	  (let (seen ran)
   474	    (dolist (event (superchat-tape-replay-events (plist-get task :session-id)))
   475	      (let ((payload (plist-get event :payload)))
   476	        (cond ((and (equal "timer.sending" (plist-get event :type))
   477	                    (equal (plist-get task :id) (plist-get payload :timer-id))
   478	                    (equal (plist-get task :occurrence) (plist-get payload :occurrence)))
   479	               (setq seen t ran nil))
   480	              ((and seen (equal "run.started" (plist-get event :type)))
   481	               (setq ran t)))))
   482	    ran))
   483	
   484	(defun superchat-timer-retry-tasks ()
   485	  "Start every fired task that has no execution on record.
   486	A task that was being sent when Emacs exited, in a conversation where a Run
   487	started afterwards, may or may not have run: that is said in the
   488	conversation, recorded as `timer.unconfirmed', and it is not started again."
   489	  (dolist (task (superchat-timer-unstarted-tasks))
   490	    (let ((session (plist-get task :session-id))
   491	          (id (plist-get task :id))
   492	          (occurrence (plist-get task :occurrence)))
   493	      (if (and (plist-get task :sending)
   494	               (not (superchat-timer--session-busy-p session))
   495	               (superchat-timer--run-after-sending-p task))
   496	          (let ((line (format "Scheduled task (due %s): %s -- Superchat cannot tell whether it started: Emacs exited while it was being sent. It was not started again."
   497	                              (superchat-timer-format-time occurrence)
   498	                              (plist-get task :text))))
   499	            (superchat-timer--fact session "timer.unconfirmed" id occurrence)
   500	            (when-let* ((view (superchat-timer--live-view session)))
   501	              (ignore-errors
   502	                (let ((superchat-buffer-name (buffer-name view)))
   503	                  (with-current-buffer view
   504	                    (superchat--insert-persistent-system-message line)))))
   505	            (message "superchat: %s" line))
   506	        (superchat-timer--try-task session id occurrence (plist-get task :text))))))
   507	
   508	
   509	(defun superchat-timer-fire (timer occurrence)
   510	  "Fire OCCURRENCE (a due time) of TIMER and return what was done.
   511	Records `timer.fired' in the Workspace's main conversation, tells the
   512	user, shows the line in that conversation's View when it is open, and for
   513	a task starts the model there.  The record comes first, so a crash
   514	afterwards never fires the same occurrence twice."
   515	  (let* ((session (superchat-timer--target-session timer))
   516	         (now (superchat-timer--now))
   517	         (late (> (- now occurrence) 60))
   518	         (kind (plist-get timer :kind))
   519	         (text (plist-get timer :text))
   520	         (line (format "%s%s: %s"
   521	                       (if (eq kind 'task) "Scheduled task" "Reminder")
   522	                       (if late (format " (due %s)" (superchat-timer-format-time occurrence)) "")
   523	                       text))
   524	         (fired (list :id (plist-get timer :id) :session-id session :kind kind
   525	                      :text text :due occurrence :late late)))
   526	    (superchat-tape-append-event
   527	     (list :type "timer.fired"
   528	           :session-id session
   529	           :actor-id "timers"
   530	           :summary line
   531	           :payload (list :timer-id (plist-get timer :id)
   532	                          :occurrence occurrence
   533	                          :kind (symbol-name kind) :text text
   534	                          :late (and late t)
   535	                          ;; A task is done only when its execution began.
   536	                          :awaits-start (eq kind 'task))))
   537	    (ignore-errors (funcall superchat-timer-notify-function fired))
   538	    (when-let* ((view (superchat-timer--live-view session)))
   539	      (ignore-errors
   540	        (let ((superchat-buffer-name (buffer-name view)))
   541	          (with-current-buffer view
   542	            (superchat--insert-persistent-system-message line)))))
   543	    (when (eq kind 'task)
   544	      (plist-put fired :run-id
   545	                 (superchat-timer--try-task session (plist-get timer :id)
   546	                                            occurrence text)))
   547	    fired))
