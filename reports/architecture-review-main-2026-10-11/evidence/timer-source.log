   101	;;;; The facts on the Tape --------------------------------------------------------
   102	
   103	(defun superchat-timer--payload-get (payload &rest keys)
   104	  "Return the first of KEYS present in the JSON alist PAYLOAD."
   105	  (cl-some (lambda (key) (alist-get key payload)) keys))
   106	
   107	(defun superchat-timer--rows ()
   108	  "Every timer fact on the Tape, oldest first, as (SESSION TYPE PAYLOAD)."
   109	  (let (out)
   110	    (dolist (row (superchat-db-tape-select
   111	                  "SELECT session_id, meta FROM tape
   112	                   WHERE kind = 'system' AND meta LIKE '%\"timer.%'
   113	                   ORDER BY id ASC"))
   114	      (let* ((json-object-type 'alist)
   115	             (json-array-type 'list)
   116	             (json-key-type 'symbol)
   117	             (meta (ignore-errors (json-read-from-string (or (nth 1 row) ""))))
   118	             (type (alist-get 'event_type meta)))
   119	        (when (member type '("timer.created" "timer.fired" "timer.cancelled"
   120	                             "timer.sending" "timer.started" "timer.unconfirmed"))
   121	          (push (list (nth 0 row) type (alist-get 'payload meta)) out))))
   122	    (nreverse out)))
   123	
   124	(defun superchat-timer-list ()
   125	  "Return every pending timer, soonest first.
   126	Each is a plist (:id :session-id :kind :text :due :repeat :workspace-id
   127	:workspace-root :last-fired :next-due).  A one-shot timer that fired and
   128	any cancelled timer are not pending."
   129	  (let ((table (make-hash-table :test #'equal)) order)
   130	    (dolist (row (superchat-timer--rows))
   131	      (cl-destructuring-bind (session type payload) row
   132	        (let ((id (superchat-timer--payload-get payload 'timer_id 'timer-id)))
   133	          (pcase type
   134	            ("timer.created"
   135	             (unless (gethash id table) (push id order))
   136	             (puthash id
   137	                      (list :id id :session-id session
   138	                            :kind (intern (or (alist-get 'kind payload) "reminder"))
   139	                            :text (alist-get 'text payload)
   140	                            :due (alist-get 'due payload)
   141	                            :repeat (alist-get 'repeat payload)
   142	                            :workspace-id (superchat-timer--payload-get
   143	                                           payload 'workspace_id 'workspace-id)
   144	                            :workspace-root (superchat-timer--payload-get
   145	                                             payload 'workspace_root 'workspace-root)
   146	                            :last-fired nil)
   147	                      table))
   148	            ("timer.fired"
   149	             (when-let* ((timer (gethash id table)))
   150	               (puthash id (plist-put timer :last-fired
   151	                                      (alist-get 'occurrence payload))
   152	                        table)))
   153	            ("timer.cancelled" (remhash id table))))))
   154	    (let (pending)
   155	      (dolist (id order)
   156	        (when-let* ((timer (gethash id table))
   157	                    (next (superchat-timer--next-due timer)))
   158	          (push (plist-put (copy-sequence timer) :next-due next) pending)))
   159	      (sort pending (lambda (a b) (< (plist-get a :next-due)
   160	                                     (plist-get b :next-due)))))))
   161	
   162	(defun superchat-timer-fired-since (since)
   163	  "Return the timers that fired at or after SINCE, oldest first.
   164	Each is a plist (:id :session-id :kind :text :due :late), :due being the
   165	occurrence that fired.  A fired line is not sent to the model as history,
   166	so this is how it can answer \"did I miss a reminder?\"."
   167	  (let (out)
   168	    (dolist (row (superchat-timer--rows))
   169	      (cl-destructuring-bind (session type payload) row
   170	        (when (equal type "timer.fired")
   171	          (let ((occurrence (alist-get 'occurrence payload)))
   172	            (when (and (numberp occurrence) (>= occurrence since))
   173	              (push (list :id (superchat-timer--payload-get payload 'timer_id 'timer-id)
   174	                          :session-id session
   175	                          :kind (intern (or (alist-get 'kind payload) "reminder"))
   176	                          :text (alist-get 'text payload)
   177	                          :due occurrence
   178	                          :late (eq t (alist-get 'late payload)))
   179	                    out))))))
   180	    (nreverse out)))
   181	
   182	(defun superchat-timer--next-due (timer)
   183	  "Return the next occurrence of TIMER that has not fired, or nil.
   184	For a one-shot timer that is its due time until it fires; for a repeating
   185	one, the first occurrence after the last one that fired."
   186	  (let ((due (plist-get timer :due))
   187	        (repeat (plist-get timer :repeat))
   188	        (last (plist-get timer :last-fired)))
   189	    (cond
   190	     ((not (numberp due)) nil)
   191	     ((not (and (numberp repeat) (> repeat 0))) (and (null last) due))
   192	     ((null last) due)
   193	     (t (+ due (* repeat (1+ (floor (/ (- last due) repeat)))))))))
   194	
   195	(defun superchat-timer--latest-occurrence (timer now)
   196	  "Return the latest occurrence of TIMER at or before NOW that has not fired.
   197	Nil when none has come due."
   198	  (let ((next (superchat-timer--next-due timer))
   199	        (repeat (plist-get timer :repeat)))
   200	    (when (and next (<= next now))
   201	      (if (and (numberp repeat) (> repeat 0))
   202	          (+ next (* repeat (floor (/ (- now next) repeat))))
   203	        next))))
   204	
   205	;;;; Creating and cancelling ---------------------------------------------------------
   206	
   207	(defun superchat-timer--workspace-of (session-id)
   208	  "Return (ID . ROOT) of the Workspace SESSION-ID is bound to, or nil."
   209	  (when (fboundp 'superchat-view-session-configuration)
   210	    (let* ((config (superchat-view-session-configuration session-id))
   211	           (id (plist-get config :workspace-id)))
   212	      (and (stringp id) (cons id (plist-get config :workspace-root))))))
   213	
   214	(defun superchat-timer--scope-of (session-id)
   215	  "The id of the Workspace SESSION-ID belongs to, or nil when it has none.
   216	A conversation belongs to a Workspace when it is bound to one with a root."
   217	  (let ((workspace (and (stringp session-id)
   218	                        (superchat-timer--workspace-of session-id))))
   219	    (and (stringp (cdr workspace)) (not (string-empty-p (cdr workspace)))
   220	         (car workspace))))
   221	
   222	(defun superchat-timer--within-p (session-id timer)
   223	  "Non-nil when SESSION-ID's conversation may see and cancel TIMER.
   224	TIMER is a plist with :session-id, the conversation it was set in.  A
   225	conversation of a Workspace: TIMER is that Workspace's.  A conversation of
   226	no Workspace: TIMER was set in that very conversation.  A pending timer
   227	carries its Workspace; a fired one is its conversation's."
   228	  (let ((asking (superchat-timer--scope-of session-id))
   229	        (owner (if (plist-member timer :workspace-root)
   230	                   (and (stringp (plist-get timer :workspace-root))
   231	                        (not (string-empty-p (plist-get timer :workspace-root)))
   232	                        (plist-get timer :workspace-id))
   233	                 (superchat-timer--scope-of (plist-get timer :session-id)))))
   234	    (if asking
   235	        (equal asking owner)
   236	      (and (stringp session-id)
   237	           (equal session-id (plist-get timer :session-id))))))
   238	
   239	(defun superchat-timer-create (session-id kind text due &optional repeat)
   240	  "Set a timer in SESSION-ID and return its plist.
   241	KIND is `reminder' (tell the user, T2) or `task' (also start the model on
   242	TEXT, T3).  DUE is the time in seconds since the epoch; REPEAT nil or a
   243	period in seconds.  The timer belongs to the Workspace SESSION-ID is
   244	bound to, and is armed at once when the `timers' row is mounted."
   245	  (unless (and (stringp session-id) (not (string-empty-p session-id)))
   300	
   301	(defun superchat-timer--target-session (timer)
   302	  "The conversation a fired TIMER speaks in: its Workspace's main one.
   303	That is the most recently active conversation bound to the Workspace; a
   304	timer set in a temporary conversation speaks in that conversation."
   305	  (or (and (plist-get timer :workspace-root)
   306	           (fboundp 'superchat-view-workspace-session-ids)
   307	           (car (superchat-view-workspace-session-ids
   308	                 (plist-get timer :workspace-id))))
   309	      (plist-get timer :session-id)))
   310	
   311	(defun superchat-timer--live-view (session-id)
   312	  "The live chat View of SESSION-ID, or nil."
   313	  (let ((buffer (and (fboundp 'superchat-editor-workspace-buffer)
   314	                     (superchat-editor-workspace-buffer session-id 'session-view))))
   315	    (and (buffer-live-p buffer) buffer)))
   316	
   317	(defun superchat-timer-notify (fired)
   318	  "Tell the user FIRED came due: the echo area and the bell."
   319	  (ding t)
   320	  (message "Superchat %s%s: %s"
   321	           (if (eq (plist-get fired :kind) 'task) "scheduled task" "reminder")
   322	           (if (plist-get fired :late)
   323	               (format " (due %s)" (superchat-timer-format-time (plist-get fired :due)))
   324	             "")
   325	           (plist-get fired :text)))
