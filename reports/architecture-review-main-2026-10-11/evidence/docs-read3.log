      (insert text))))

(defun m5rc--copy (inspector)
  "Use the actual inspector copy command without touching the OS clipboard."
  (with-current-buffer inspector (superchat-request-copy))
  (should (stringp (car kill-ring)))
  (car kill-ring))

(defun m5rc--attachment (view)
  "Attach a real tiny text file with a unique content marker to VIEW."
  (let ((file (expand-file-name "m5rc-attachment.txt" superchat-data-directory)))
    (with-temp-file file (insert "M5RC_ATTACHMENT_BODY\n"))
    (with-current-buffer view
      (setq-local superchat--current-context-files (list file)))
    file))

(defun m5rc--with-preset-system (view base function)
  "Run FUNCTION after applying a real prompt Preset whose Turn receives BASE.
Prompt Presets do not have a system-prompt slot and their body is not a
persona.  The test supplies an ordinary programmable Turn customization at
the existing Preset application seam, only for this exact Preset object.
The original application, active-View lookup and all assembly still run."
  (let ((preset (superchat-preset-from-plist
                 '(:name "m5rc-active" :type prompt
                   :body "M5RC_PROMPT_BODY_NOT_A_PERSONA")))
(defun superchat--cmd-builtin-capability (name)
  "Activate the built-in Capability NAME."
  (let ((preset (superchat--builtin-capability-preset name)))
    (unless preset
      (error "Unknown built-in Capability: %s" name))
    (superchat--activate-capability preset name)
    (message "🎯 Active Capability: %s" name)
    `(:type :echo :content ,(format "Capability: %s" name))))

(defun superchat--cmd-code (_cmd _args _input _lang _target-model)
  "Activate the built-in coding Capability."
  (superchat--cmd-builtin-capability "code"))

(defun superchat--cmd-research (_cmd _args _input _lang _target-model)
  "Activate the built-in research Capability."
  (superchat--cmd-builtin-capability "research"))

(defun superchat--cmd-cowork (_cmd _args _input _lang _target-model)
  "Activate the built-in cowork Capability."
  (superchat--cmd-builtin-capability "cowork"))

(defun superchat--cmd-team (_cmd args _input _lang _target-model)
  "Select team Topology for following turns.
When ARGS names a directory, also bind it as the Session Workspace."
  (let* ((arg (string-trim (or args "")))
         (directory (unless (string-empty-p arg)
                      (file-name-as-directory (expand-file-name arg)))))
    (if (and directory (not (file-directory-p directory)))
        '(:type :echo :content "Usage: /team [existing-directory]")
      (when directory (superchat--bind-workspace directory))
      (superchat--set-topology 'team)
      `(:type :echo
        :content ,(format "Topology: team%s."
                          (if directory
                              (format "; Workspace: %s" directory)
                            ""))))))

(defun superchat--cmd-single (_cmd _args _input _lang _target-model)
  "Select single-Agent Topology without changing Capability."
  (superchat--set-topology 'single)
  '(:type :echo :content "Topology: single"))

(defun superchat--workspace-echo (binding)
  "Return the echo line naming the Workspace BINDING."
  (format "Workspace: %s (%s)"
          (file-name-nondirectory (directory-file-name (plist-get binding :root)))
          (plist-get binding :root)))

(defun superchat--cmd-workspace (_cmd args _input _lang _target-model)
  "Show, declare, or clear the current Session's Workspace.
A Session's Workspace is fixed at creation: only a Session with no user
or assistant rows can still change it."
  (let ((value (string-trim (or args "")))
        (fresh (not (superchat--session-has-turns-p superchat--session-id))))
    (cond
     ((string-empty-p value)
      `(:type :echo
        :content ,(if superchat--workspace-binding
                      (superchat--workspace-echo superchat--workspace-binding)
                    "Workspace: none")))
     ((string= value "clear")
      (if fresh
          (progn (superchat--bind-workspace nil)
                 '(:type :echo :content "Workspace: none"))
        '(:type :echo
          :content "This conversation stays in its workspace; start a new conversation to change it.")))
     ((file-directory-p (expand-file-name value))
      (let* ((workspace (superchat-workspace-declare (expand-file-name value)))
             (target (list :id (plist-get workspace :id)
                           :root (plist-get workspace :root))))
        (cond
         ((and (null superchat--workspace-binding) fresh)
          (superchat--apply-workspace-binding target)
          `(:type :echo :content ,(superchat--workspace-echo target)))
         ((equal (plist-get superchat--workspace-binding :id)
                 (plist-get target :id))
          `(:type :echo
            :content ,(superchat--workspace-echo superchat--workspace-binding)))
         (t
          ;; S1: this conversation stays; the declared Workspace's own
          ;; conversation opens once the command has answered.
          (run-at-time 0 nil #'superchat--open-workspace-conversation workspace)
          `(:type :echo
            :content ,(format "Declared workspace %s (%s). This conversation stays where it is; opening that workspace's conversation."
                              (file-name-nondirectory
                               (directory-file-name (plist-get target :root)))
