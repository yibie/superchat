;;; annotation-probes.el --- Round 3 annotation observations -*- lexical-binding: t; -*-
(load (expand-file-name "scripts/annotate-chat-regression.el" default-directory) nil t)
(load (expand-file-name "scripts/annotate-regression.el" default-directory) nil t)

(ert-deftest r3-annotation/quote-search-is-case-folded ()
  (wrules--with '((:text "1 | target | LOWERCASE-REMARK")) (p)
    (let* ((buffer (ann--file p "TARGET\n"))
           (before (with-current-buffer buffer (buffer-string)))
           (tick (with-current-buffer buffer (buffer-chars-modified-tick))))
      (ann--annotate buffer)
      (should (equal '((1 "TARGET" "LOWERCASE-REMARK")) (ann--placed buffer)))
      (with-current-buffer buffer
        (should (equal before (buffer-string)))
        (should (= tick (buffer-chars-modified-tick))))
      (princ "R3-04 OBSERVED: model quotes lowercase target, source contains only uppercase TARGET; annotation placed, source text/tick unchanged.\n"))))

(ert-deftest r3-annotation/reopening-view-forgets-hung-fact-while-overlay-lives ()
  (m5rc--fixture `((:text ,annc--answer) (:text "FOLLOWUP"))
    (let* ((source (m5rc--source annc--text))
           (view (m5rc--open source))
           (session (buffer-local-value 'superchat--session-id view))
           (superchat-automated-input nil))
      (smoke--send view "Mark it >annotate")
      (m5rc--settle 1)
      (should (= 2 (length (annc--placed source))))
      (should (cdr (buffer-local-value 'superchat--annotated-buffers view)))
      (kill-buffer view)
      (setq view (let ((default-directory superchat-data-directory))
                   (superchat--render-session-view session)))
      (should (= 2 (length (annc--placed source))))
      (smoke--send view "Say hello only")
      (let ((request (m5rc--settle 2)))
        (should-not (annc--earlier-p request))
        (should (cl-some (lambda (s) (string-match-p ">annotate" s)) (plist-get request :users)))
        (princ "R3-05 OBSERVED: same Session, same Emacs, source still has 2 remarks; close/reopen only the View => history keeps >annotate but next provider system loses the hung/completed note.\n")))))

(ert-deftest r3-annotation/inspected-annotate-has-sink-but-no-row-contract ()
  (m5rc--fixture '((:text "An ordinary prose answer."))
    (let* ((source (m5rc--source annc--text))
           (superchat-automated-input nil)
           (inspector (m5rc--inspect source "Mark the issue >annotate")))
      (should-not (string-match-p "1| alpha one" (m5rc--body inspector)))
      (with-current-buffer inspector (superchat-request-send))
      (let ((request (m5rc--settle 1)))
        (should-not (annc--form-p request))
        (should-not (string-match-p "1| alpha one" (annc--last-user request)))
        (should-not (annc--tools))
        (should-not (annc--placed source))
        (should (equal '("An ordinary prose answer.")
                       (plist-get (buffer-local-value 'superchat-annotate--report source) :unparsed)))
        (princ "R3-06 OBSERVED: actual act inspector send has no tools, no LINE | QUOTE | REMARK, no numbered target; annotation sink still parses prose as 1 unparsed line.\n")))))

(ert-deftest r3-annotation/two-pending-command-answers-accumulate ()
  (wrules--with '((:text "2 | beta | FIRST" :delay 0.15)
                  (:text "2 | beta | SECOND")) (p)
    (let ((buffer (ann--file p)))
      (with-current-buffer buffer
        (superchat-annotate "first")
        (superchat-annotate "second"))
      (should (smoke--wait
               (lambda () (and (= 2 (length hm--wires))
                               (null (superchat-runtime-active-runs)))) 5))
      (should (= 2 (length (ann--placed buffer))))
      (should (= 1 (plist-get (buffer-local-value 'superchat-annotate--report buffer) :placed)))
      (princ "R3-07 OBSERVED: second command while first pending => 2 overlapping remarks retained; latest report says placed=1; queued Runtime not a second execution engine.\n"))))

