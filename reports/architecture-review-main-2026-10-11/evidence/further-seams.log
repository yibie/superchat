   651	(defun superchat-timer-tool-create (text kind &optional in-minutes at repeat)
   652	  "The `timer_create' tool: set a timer in the asking conversation.
   653	A timer is a promise that something happens at its time.  While the
   654	`timers' row is not mounted nothing would fire it, so it is refused
   655	rather than written and never acted on."
   656	  (condition-case err
   657	      (let* ((now (progn
   658	                    (unless (superchat-timer--active-p)
   659	                      (error "%s, so no timer was set and nothing will happen at that time; tell the user"
   660	                             superchat-timer--off))
   661	                    (superchat-timer--now)))
   662	             (kind (pcase kind
   663	                     ((or "task" 'task) 'task)
   664	                     ((or "reminder" 'reminder 'nil "") 'reminder)
   665	                     (_ (error "kind must be reminder or task"))))
   666	             (due (cond
   667	                   ((and (stringp at) (not (string-empty-p at)))
   668	                    (superchat-timer-parse-time at))
   669	                   ((numberp in-minutes) (+ now (* 60 in-minutes)))
   670	                   ((and (stringp in-minutes) (string-match-p "\\`[0-9.]+\\'" in-minutes))
   671	                    (+ now (* 60 (string-to-number in-minutes))))
   672	                   (t (error "Give in_minutes or at"))))
   673	             (period (cond
   674	                      ((or (null repeat) (member repeat '("" "none"))) nil)
   675	                      ((cdr (assoc repeat superchat-timer-repeats)))
   676	                      (t (error "repeat must be hourly, daily, weekly or none")))))
   677	        (when (and (< due now) (null period))
   678	          (error "That time has passed: %s" (superchat-timer-format-time due)))
   679	        ;; "Take this work up again at that time" is a wait on its Work
   680	        ;; Record, not a timer (contract T4): in the real task T4W the model
   681	        ;; set a task timer for it, which ran in the old conversation.
   682	        (when (and (eq kind 'task)
   683	                   (fboundp 'superchat-work-current)
   684	                   (superchat-work-current (superchat-timer--tool-session)))
   685	          (error "This conversation has a current work record; to take that work up again later, use work_record with action wait, wait_for time and in_minutes or at -- it continues in a new conversation with the record.  A task timer is for a new, separate job"))
   686	        (let ((timer (superchat-timer-create (superchat-timer--tool-session)
   687	                                             kind text due period)))
   688	          (format "Timer %s set: %s at %s%s (now %s).%s"
   689	                  (plist-get timer :id)
   690	                  (if (eq kind 'task) "the task will run" "the user will be reminded")
   691	                  (superchat-timer-format-time due)
   692	                  (if period (format ", then %s" (superchat-timer--repeat-name period)) "")
   693	                  (superchat-timer-format-time now)
   694	                  (if (plist-get timer :workspace-root)
   695	                      ""
   696	                    "  This conversation belongs to no workspace: the timer fires in it."))))
   697	    (error (format "Error: %s" (error-message-string err)))))
