(ert-deftest annotate-chat/another-conversation-in-the-same-view-is-not-told ()
  (m5rc--fixture `((:text ,annc--answer))
    (let* ((source (m5rc--source annc--text))
           (view (m5rc--open source))
           (superchat-automated-input nil))
      (smoke--send view "ANNC_MARK_THEM >annotate")
      (m5rc--settle 1)
      (let ((session (buffer-local-value 'superchat--session-id view))
            (context (list :chat-buffer view)))
        ;; The conversation that annotated is told; any other Session shown
        ;; in the same View is not.
        (should (superchat-prompt-collector--annotate
                 (list :surface 'chat :session-id session :context context) nil nil))
        (should-not (superchat-prompt-collector--annotate
                     (list :surface 'chat :session-id "annc-other-session"
                           :context context)
                     nil nil))))))

(ert-deftest annotate-chat/the-request-can-be-rebuilt-from-the-record ()
  (m5rc--fixture `((:text ,annc--answer))
    (let* ((source (m5rc--source annc--text))
           (view (m5rc--open source))
           (superchat-automated-input nil))
      (smoke--send view "ANNC_MARK_THEM >annotate")
      (m5rc--settle 1)
      ;; The same verdict the smoke reads for an ordinary message.
      (should (equal '(reproduced . 0)
                     (smoke--case-reconstruction
                      (buffer-local-value 'superchat--session-id view)))))))

(defun superchat-preset-apply (preset turn)
  "Apply PRESET to TURN, mutating turn slots.
Sets :preset, :target-model, :tools, and runs the :pre hook.
Returns the modified TURN.

Model precedence: an explicit per-turn @model (already parsed into
TURN by the core pipeline) wins over the preset's model — the preset
only fills the slot when it is still empty.

For agent and plan presets, the skill body is the persona: it is
prepended to TURN's system-prompt so it reaches the LLM as system
context on every turn, not only on explicit skill invocation.
Prompt-type presets keep their body out of the system prompt — for
them the body is a prompt template handled by the skills layer."
  (when preset
    (setf (superchat-turn-preset turn) preset)
    (when (and (superchat-preset-model preset)
               (null (superchat-turn-target-model turn)))
      (setf (superchat-turn-target-model turn)
1824:   (superchat-preset-plugins preset)))
