   699	(defun superchat-timer-tool-list ()
   700	  "The `timer_list' tool: the pending timers, then those fired in the last day.
   701	Only those of the asking conversation's Workspace; of that conversation
   702	alone when it belongs to none."
   703	  (let* ((session (superchat-timer--tool-session))
   704	         (mine (lambda (timer) (superchat-timer--within-p session timer)))
   705	         (timers (cl-remove-if-not mine (superchat-timer-list)))
   706	         (fired (cl-remove-if-not
   707	                 mine (superchat-timer-fired-since (- (superchat-timer--now) 86400)))))
   708	    (concat
   709	     (format "Now %s.\n" (superchat-timer-format-time (superchat-timer--now)))
   710	     (if (superchat-timer--active-p)
   711	         ""
   712	       (format "%s: nothing below fires until they are turned on again.\n"
   713	               superchat-timer--off))
   714	     (if (null timers)
   715	         "No pending timers."
   716	       (concat
   717	        "Pending:\n"
   718	        (mapconcat (lambda (timer)
   719	                   (format "%s  %s  %s%s  %s"
   720	                           (plist-get timer :id)
   721	                           (superchat-timer-format-time (plist-get timer :next-due))
   722	                           (plist-get timer :kind)
   723	                           (if (plist-get timer :repeat)
   724	                               (format " (%s)" (superchat-timer--repeat-name
   725	                                                (plist-get timer :repeat)))
   726	                             "")
   727	                           (plist-get timer :text)))
   728	                 timers "\n")))
   729	     (if (null fired)
   730	         "\nNone fired in the last 24 hours."
   731	       (concat
   732	        "\nFired in the last 24 hours:\n"
   733	        (mapconcat (lambda (timer)
   734	                     (format "%s  %s%s  %s"
   735	                             (superchat-timer-format-time (plist-get timer :due))
   736	                             (plist-get timer :kind)
   737	                             (if (plist-get timer :late)
   738	                                 " (Emacs was not running then; shown when it started)"
   739	                               "")
   740	                             (plist-get timer :text)))
   741	                   fired "\n"))))))
