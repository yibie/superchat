   564	(defun superchat-prompt-collector--annotate (env _state _tools)
   565	  "Return the fragments of a conversation message whose answer is annotations.
   566	The dispatcher puts `:chat-annotate' in ENV's context for a message that
   567	names `>annotate'.  The row form goes last among the system text, after the
   568	persona and the Workspace rules; the text to annotate, with line numbers,
   569	rides as an attachment.
   570	
   571	Any other message of a conversation that annotated before is told so
   572	\(`superchat-prompt--annotate-earlier-note'): the earlier answer's rows are
   573	in its history, and nothing there says they were already hung on the text."
   574	  (if-let* ((spec (plist-get (plist-get env :context) :chat-annotate)))
   575	    (list (superchat-prompt-fragment
   576	           :owner 'chat :id "annotate-form" :slot 'system
   577	           :text (concat (superchat-annotate--system-text) "\n\n"
   578	                         superchat-prompt--annotate-chat-note "\n\n"
   579	                         superchat-prompt--annotate-rules-note)
   580	           :priority -10 :budget-class 'hard)
   581	          (superchat-prompt-fragment
   582	           :owner 'chat :id "annotate-text" :slot 'attachment
   583	           :text (format "The text to annotate, %s, with line numbers:\n<<<TEXT>>>\n%s\n<<<END TEXT>>>\n\nReply with rows of the form LINE | QUOTE | REMARK only."
   584	                         (plist-get spec :name) (plist-get spec :text))
   585	           :priority 0 :budget-class 'hard :required t
   586	           :source (list :annotate (plist-get spec :name))))
   587	    (when-let* (((eq (plist-get env :surface) 'chat))
   588	                (view (plist-get (plist-get env :context) :chat-buffer))
   589	                ((buffer-live-p view))
   590	                (record (buffer-local-value 'superchat--annotated-buffers view))
   591	                ((equal (car record) (plist-get env :session-id)))
   592	                (names (cdr record)))
   593	      (list (superchat-prompt-fragment
   594	             :owner 'chat :id "annotate-earlier" :slot 'system
   595	             :text (format superchat-prompt--annotate-earlier-note
   596	                           (mapconcat #'identity (reverse names) ", "))
   597	             :priority -10 :budget-class 'hard)))))
