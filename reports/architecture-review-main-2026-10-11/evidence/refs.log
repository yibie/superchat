   977	(defun superchat--annotated-remember (view session-id name)
   978	  "Note in VIEW that SESSION-ID's conversation hung remarks on buffer NAME."
   979	  (when (buffer-live-p view)
   980	    (with-current-buffer view
   981	      (setq superchat--annotated-buffers
   982	            (cons session-id
   983	                  (cl-adjoin name
   984	                             (and (equal (car superchat--annotated-buffers)
   985	                                         session-id)
   986	                                  (cdr superchat--annotated-buffers))
   987	                             :test #'equal))))))
