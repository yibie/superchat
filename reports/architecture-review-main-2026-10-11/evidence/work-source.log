   678	(defun superchat-work-complete-by-user (record conclusion)
   679	  "Write the user's completion of RECORD, with CONCLUSION, to its own Tape."
   680	  (superchat-work-complete (plist-get record :session-id) (plist-get record :id)
   681	                           conclusion 'user))
