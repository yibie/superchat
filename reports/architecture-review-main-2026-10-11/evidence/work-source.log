   652	(defun superchat-work-list-show (id)
   653	  "Show the full text of record ID, by default the one at point."
   654	  (interactive (list (tabulated-list-get-id)))
   655	  (when id
   656	    (with-help-window "*superchat work record*"
   657	      (let ((record (superchat-work-get id)))
   658	        (princ (superchat-work-render record))
   659	        (when-let* ((text (superchat-work-executions-text record)))
