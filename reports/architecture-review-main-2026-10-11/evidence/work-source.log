   504	;;;; The tool -----------------------------------------------------------------------
   505	
   506	(defun superchat-work--tool-session ()
   507	  (or (and (boundp 'superchat--tool-execution-context)
   508	           (plist-get superchat--tool-execution-context :session-id))
   509	      (and (boundp 'superchat--session-id) superchat--session-id)))
   510	
   511	(defvar superchat--session-id)
   512	
   513	(declare-function superchat-timer-parse-time "superchat-timer" (at))
   514	
   515	(defun superchat-work-tool (action &optional id goal progress blocked resume
   516	                                   wait_for detail conclusion follows
   517	                                   in_minutes at)
   518	  "The `work_record' tool: ACTION is start, update, wait, done or read."
   519	  (condition-case err
   520	      (let* ((session (superchat-work--tool-session))
   521	             (id (if (and (stringp id) (not (string-empty-p id)))
   522	                     id
   523	                   (superchat-work-current session))))
   524	        ;; The record named, and the one a new record follows, are this
   525	        ;; conversation's Workspace's, before anything is read or written.
   526	        (when (and id (member action '("update" "wait" "done" "read")))
   527	          (superchat-work--for session id))
   528	        (when (and (equal action "start")
   529	                   (stringp follows) (not (string-empty-p follows)))
   530	          (superchat-work--for session follows))
   531	        (pcase action
   532	          ("start"
   533	           ;; What comes with a start is recorded with it, or the start is
   534	           ;; refused: never "Started" with part of the call dropped.
   535	           (when (and (stringp conclusion) (not (string-empty-p conclusion)))
   536	             (error "A record is not started and completed in one call; start it, and use action done with the conclusion when it is delivered"))
   537	           (let* ((waits (and (stringp wait_for) (not (string-empty-p wait_for))))
   538	                  (until (and waits
   539	                              (cond ((and (stringp at) (not (string-empty-p at)))
   540	                                     (superchat-timer-parse-time at))
   541	                                    ((numberp in_minutes)
   542	                                     (+ (superchat-work--now) (* 60 in_minutes))))))
   543	                  (_ (when waits (superchat-work--check-wait wait_for until)))
   544	                  (new (superchat-work-start session goal follows))
   545	                  (said (format "Started %s; it is this conversation's current work record."
   546	                                new)))
   547	             (when (or progress blocked resume)
   548	               (superchat-work-update session new progress blocked resume))
   549	             (when waits
   550	               (superchat-work-wait session new wait_for detail until))
   551	             (if (or progress blocked resume waits)
   552	                 (concat said "\n" (superchat-work-render (superchat-work-get new)))
   553	               said)))
   554	          ("update"
   555	           (unless id (error "No current work record; start one or give its id"))
   556	           ;; A wait given with an update is registered too, never dropped: in
   557	           ;; the real task T4W the model put wait_for and in_minutes on an
   558	           ;; update and believed the wait was registered.  It is checked
   559	           ;; before anything is written, so a refused wait leaves no half
   560	           ;; of the call behind.
   561	           (let* ((waits (and (stringp wait_for) (not (string-empty-p wait_for))))
   562	                  (until (and waits
   563	                              (cond ((and (stringp at) (not (string-empty-p at)))
   564	                                     (superchat-timer-parse-time at))
   565	                                    ((numberp in_minutes)
   566	                                     (+ (superchat-work--now) (* 60 in_minutes)))))))
   567	             (unless (or progress blocked resume waits)
   568	               (error "Say how far it got, why the next step waits, or where to pick it up"))
   569	             (when waits (superchat-work--check-wait wait_for until))
   570	             (when (or progress blocked resume)
   571	               (superchat-work-update session id progress blocked resume))
   572	             (when waits
   573	               (superchat-work-wait session id wait_for detail until)))
   574	           (superchat-work-render (superchat-work-get id)))
   575	          ("wait"
   576	           (unless id (error "No current work record; start one or give its id"))
   577	           (superchat-work-wait
   578	            session id (and (stringp wait_for) (not (string-empty-p wait_for)) wait_for)
   579	            detail
   580	            (cond ((and (stringp at) (not (string-empty-p at)))
   581	                   (superchat-timer-parse-time at))
   582	                  ((numberp in_minutes) (+ (superchat-work--now) (* 60 in_minutes)))))
   583	           (superchat-work-render (superchat-work-get id)))
   584	          ("done"
   585	           (unless id (error "No current work record; give its id"))
   586	           (superchat-work-complete session id conclusion)
   587	           (format "Completed %s." id))
   588	          ("read"
   589	           (unless id (error "Give the id of a work record"))
   590	           (superchat-work-render (or (superchat-work-get id)
   591	                                      (error "No work record %s" id))))
   592	          (_ (error "action must be start, update, wait, done or read"))))
   593	    (error (format "Error: %s" (error-message-string err)))))
