    70	
    71	(defun superchat-work--build (rows)
    72	  "Fold ROWS into a hash table of records by id, and the order they began."
    73	  (let ((table (make-hash-table :test #'equal)) order)
    74	    (dolist (row rows)
    75	      (cl-destructuring-bind (session type payload) row
    76	        (let* ((id (superchat-work--get payload 'work_id 'work-id))
    77	               (record (and id (gethash id table))))
    78	          (pcase type
    79	            ("work.created"
    80	             (unless record
    81	               (push id order)
    82	               (puthash id
    83	                        (list :id id :session-id session
    84	                              :goal (alist-get 'goal payload)
    85	                              :follows (alist-get 'follows payload)
    86	                              :workspace-id (superchat-work--get payload 'workspace_id 'workspace-id)
    87	                              :workspace-root (superchat-work--get payload 'workspace_root 'workspace-root)
    88	                              :progress nil :blocked nil :resume nil
    89	                              :waiting nil :conclusion nil :completed-by nil
    90	                              :facts nil :outcomes nil)
    91	                        table)))
    92	            ("work.updated"
    93	             (when record
    94	               (dolist (field '(progress blocked resume))
    95	                 (when-let* ((value (alist-get field payload)))
    96	                   (setq record (plist-put record (intern (format ":%s" field)) value))))
    97	               (puthash id record table)))
    98	            ("work.waiting"
    99	             (when record
   100	               (puthash id (plist-put record :waiting
   101	                                      (and (alist-get 'for payload)
   102	                                           (list :for (alist-get 'for payload)
   103	                                                 :detail (alist-get 'detail payload)
   104	                                                 :until (alist-get 'until payload))))
   105	                        table)))
   106	            ("work.task"
   107	             (when record
   108	               (puthash id (plist-put record :tasks
   109	                                      (append (plist-get record :tasks)
   110	                                              (list (list :task (alist-get 'task payload)
   111	                                                          :status (alist-get 'status payload)
   112	                                                          :report (alist-get 'report payload)
   113	                                                          :conversation (alist-get 'conversation payload)))))
   114	                        table)))
   115	            ("work.woken"
   116	             (when record
   117	               (setq record (plist-put record :woken
   118	                                       (append (plist-get record :woken)
   119	                                               (list (alist-get 'until payload)))))
   120	               (puthash id (plist-put record :wakes
   121	                                      (append (plist-get record :wakes)
   122	                                              (list (list :until (alist-get 'until payload)
   123	                                                          :detail (alist-get 'detail payload)
   124	                                                          :session session
   125	                                                          :main (alist-get 'main payload)))))
   126	                        table)))
   127	            ("work.reported"
   128	             (when record
   129	               (puthash id (plist-put record :reported
   130	                                      (append (plist-get record :reported)
   400	                 (format "To deliver: %s" (plist-get record :goal))
   401	                 (and (plist-get record :follows)
   402	                      (format "Follows: %s" (plist-get record :follows)))
   403	                 (format "Done so far: %s" (or (plist-get record :progress) "nothing recorded yet"))
   404	                 ;; A completed record has no next step: these would be stale.
   405	                 (and (plist-get record :blocked) (not (plist-get record :conclusion))
   406	                      (format "Why the next step waits: %s" (plist-get record :blocked)))
   407	                 (and (plist-get record :resume) (not (plist-get record :conclusion))
   408	                      (format "Pick up from: %s" (plist-get record :resume)))
   409	                 (and (equal "interrupted" (car (last (plist-get record :outcomes))))
   410	                      (not (plist-get record :conclusion))
   411	                      "Its last execution was cut off when Emacs exited (recorded by Superchat): check what it left before going on.")
   412	                 (and files
   413	                      (format "Files its executions changed (recorded by Superchat): %s"
   414	                              (string-join files ", ")))
   415	                 (and changes
   416	                      (format "jj changes those executions left in the workspace: %s"
   417	                              (string-join changes ", ")))
   418	                 (and (plist-get record :tasks)
   419	                      (concat "Delegated tasks (recorded by Superchat):\n"
   420	                              (mapconcat
   421	                               (lambda (task)
   422	                                 (format "- %s -- %s: %s"
   423	                                         (superchat-work--clip (plist-get task :task) 120)
   424	                                         (plist-get task :status)
   425	                                         (superchat-work--clip (plist-get task :report) 300)))
   426	                               (plist-get record :tasks) "\n")))
   427	                 (and (plist-get record :conclusion)
   428	                      (format "Conclusion: %s" (plist-get record :conclusion)))))
   429	     "\n")))
   430	
   431	;;;; What a request carries (K8, K9) ------------------------------------------------
   432	
   433	(defconst superchat-work-list-max 8
   434	  "Most records listed in each group of a request's list.")
   435	
   436	(defconst superchat-work-background-text
   437	  "The conversation's earlier turns are background: do not take up earlier \
   438	work again unless the user's message or the current work record asks for it."
   439	  "What a request with a current record says about the turns before it (K9).")
   440	
   441	(defun superchat-work-request-text (session-id)
   442	  "The Work Record text of a request from SESSION-ID, or nil.
   443	The current record in full, then this Workspace's other open and recently
   444	completed records by status, one line each; never another Workspace's (K8)."
   445	  (when-let* ((workspace (superchat-work--workspace session-id)))
   446	    (let* ((records (superchat-work-records (car workspace)))
   447	           (current (superchat-work-current session-id))
   448	           (others (cl-remove current records
   449	                              :key (lambda (r) (plist-get r :id)) :test #'equal))
   450	           (week-ago (- (float-time) (* 7 86400)))
   451	           (groups
   452	            (list (cons "Continuable" (cl-remove-if-not
   453	                                       (lambda (r) (eq 'continuable (superchat-work-status r)))
   454	                                       others))
   455	                  (cons "Waiting for the user" (cl-remove-if-not
   456	                                                (lambda (r) (eq 'waiting-user (superchat-work-status r)))
   457	                                                others))
   458	                  (cons "Waiting for something else" (cl-remove-if-not
   459	                                                      (lambda (r) (eq 'waiting-other (superchat-work-status r)))
   460	                                                      others))
   461	                  (cons "Recently completed"
   462	                        (reverse (cl-remove-if-not
   463	                                  (lambda (r) (and (eq 'completed (superchat-work-status r))
   464	                                                   (> (superchat-work--started r) week-ago)))
   465	                                  others)))))
   466	           (listed (cl-remove-if-not #'cdr groups)))
   467	      (when (or current listed)
   468	        (string-join
   469	         (delq nil
   470	               (list
   471	                "[Work records]"
   472	                (if current
   473	                    (concat "Current work record:\n"
   474	                            (superchat-work-render (superchat-work-get current))
   475	                            "\n" superchat-work-background-text)
   476	                  "No current work record in this conversation.")
   477	                (and listed
   478	                     (concat
   479	                      "Other work records in this workspace (read one with work_record action read):\n"
   480	                      (mapconcat
   481	                       (lambda (group)
   482	                         (concat (car group) ":\n"
   483	                                 (mapconcat (lambda (r)
   484	                                              (format "- %s: %s" (plist-get r :id) (plist-get r :goal)))
   485	                                            (seq-take (cdr group) superchat-work-list-max)
   486	                                            "\n")))
   487	                       listed "\n")))))
   488	         "\n\n")))))
   489	
   490	(defun superchat-work--started (record)
   491	  "When RECORD began, in seconds, from the time in its id."
   492	  (let ((id (plist-get record :id)))
   493	    (if (string-match "\\`work-\\([0-9]\\{14\\}\\)" id)
   494	        (let ((stamp (match-string 1 id)))
   495	          (float-time (encode-time (list (string-to-number (substring stamp 12 14))
   496	                                         (string-to-number (substring stamp 10 12))
   497	                                         (string-to-number (substring stamp 8 10))
   498	                                         (string-to-number (substring stamp 6 8))
   499	                                         (string-to-number (substring stamp 4 6))
   500	                                         (string-to-number (substring stamp 0 4))
   501	                                         nil -1 nil))))
   502	      0)))
