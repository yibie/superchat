   604	(defun superchat-work--list-entries ()
   605	  "Rows of the records list: open ones first, newest first within a status."
   606	  (mapcar (lambda (record)
   607	            (list (plist-get record :id)
   608	                  (vector (plist-get record :id)
   609	                          (superchat-work-status-text record)
   610	                          (let ((root (plist-get record :workspace-root)))
   611	                            (if root (file-name-nondirectory (directory-file-name root)) ""))
   612	                          (or (plist-get record :goal) ""))))
   613	          (sort (reverse (superchat-work-records))
   614	                (lambda (a b) (< (superchat-work--status-order a)
   615	                                 (superchat-work--status-order b))))))
