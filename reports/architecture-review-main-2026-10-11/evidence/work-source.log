   641	(defun superchat-work-executions-text (record)
   642	  "RECORD's executions, one per line, oldest first; nil when it has none.
   643	For the user, who asks which execution did what; a request does not carry it."
   644	  (when-let* ((executions (plist-get record :executions)))
   645	    (concat "Executions (recorded by Superchat):\n"
   646	            (mapconcat (lambda (e)
   647	                         (format "- %s in conversation %s: %s"
   648	                                 (plist-get e :run-id) (plist-get e :session)
   649	                                 (plist-get e :outcome)))
   650	                       executions "\n"))))
