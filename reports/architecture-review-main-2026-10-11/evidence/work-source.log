   617	(defvar superchat-work-list-mode-map
   618	  (let ((map (make-sparse-keymap)))
   619	    (define-key map (kbd "RET") #'superchat-work-list-show)
   620	    (define-key map (kbd "c") #'superchat-work-list-complete)
