   691	
   692	(declare-function superchat-workspace-new-conversation "superchat" (workspace))
   693	(declare-function superchat-view-workspace-session-ids "superchat-tape-view" (workspace-id))
   694	(declare-function superchat-editor-workspace-buffer "superchat-editor-workspace"
   695	                  (session-id role &optional create))
   696	(declare-function superchat--insert-persistent-system-message "superchat-render" (text))
   697	(declare-function superchat-send-input "superchat-dispatcher" ())
   698	(declare-function superchat-runtime-status "superchat-runtime" (run-id))
   699	(defvar superchat-buffer-name)
   700	(defvar superchat--active-run-id)
   701	(defvar superchat-automated-input)
   702	(defvar superchat-user-input-functions)
   703	
   704	(defvar superchat-work-now-function #'float-time
   705	  "Function returning the current time in seconds; tests replace it.")
   706	
   707	(defvar superchat-work--armed (make-hash-table :test #'equal)
   708	  "Record id -> the Emacs timer that will wake it.")
   709	
   710	(defvar superchat-work-wake-retry-seconds 300
   711	  "Seconds after a wake that started nothing before it is tried again.")
   712	
   713	(defvar superchat-work-wake-retry-limit 3
   714	  "How many times one Emacs tries a failed wake again by itself.
   715	After that the record stays waiting for its past time until Superchat starts
   716	again.")
   717	
   718	(defvar superchat-work--retries (make-hash-table :test #'equal)
   719	  "Record id -> how many wakes of it failed in this Emacs.")
   720	
   721	(defconst superchat-work-wake-prompt
   722	  "Take up work record %s again: the time it was waiting for has come."
   723	  "The first message of the conversation a woken record starts in.")
   724	
   725	(defun superchat-work--now () (funcall superchat-work-now-function))
   726	
   727	(defun superchat-work--wake-active-p ()
   728	  (and (fboundp 'superchat-plugin-row-active-p)
   729	       (superchat-plugin-row-active-p 'work-records)))
   730	
   731	(defun superchat-work--session-ran-p (session-id)
   732	  "Non-nil when an execution ever started in SESSION-ID, by its Tape."
   733	  (cl-some (lambda (event) (equal "run.started" (plist-get event :type)))
   734	           (superchat-tape-replay-events session-id)))
   735	
   736	(defun superchat-work--due-p (record)
   737	  "Non-nil when RECORD waits for a time that no execution was started for.
   738	A wake whose conversation never ran an execution does not count: sending
   739	failed, or Emacs quit in between, and the wait was put back."
   740	  (let* ((waiting (plist-get record :waiting))
   741	         (until (plist-get waiting :until)))
   742	    (and (equal "time" (plist-get waiting :for))
   743	         (numberp until)
   744	         (not (plist-get record :conclusion))
   745	         (not (cl-some (lambda (wake)
   746	                         (and (equal until (plist-get wake :until))
   747	                              (superchat-work--session-ran-p (plist-get wake :session))))
   748	                       (plist-get record :wakes))))))
   749	
   750	(defun superchat-work--restore-wait (session-id record-id until detail)
   751	  "Put back RECORD-ID's wait for the time UNTIL: its wake started nothing."
   752	  (superchat-work--append session-id "work.waiting"
   753	                          (format "Work record %s waits again: its wake started nothing"
   754	                                  record-id)
   755	                          (list :work-id record-id :for "time" :until until
   756	                                :detail detail)))
   757	
   758	(defun superchat-work--restore-lost-wake (record)
   759	  "Put back RECORD's wait when its last wake was cut off; non-nil if it did.
   760	Cut off means: the wake wrote its facts, no execution ever started in its
   761	conversation, and nothing was written to the record since.  This is what an
   762	Emacs that quit in the middle of a wake leaves behind."
   763	  (let ((wake (car (last (plist-get record :wakes)))))
   764	    (when (and wake
   765	               (not (plist-get record :conclusion))
   766	               (not (plist-get record :waiting))
   767	               (equal (plist-get wake :session) (plist-get record :last-session))
   768	               (not (superchat-work--session-ran-p (plist-get wake :session))))
   769	      (superchat-work--restore-wait (plist-get wake :session) (plist-get record :id)
   770	                                    (plist-get wake :until) (plist-get wake :detail))
   771	      t)))
   772	
   773	(defun superchat-work--disarm (id)
   774	  (when-let* ((timer (gethash id superchat-work--armed)))
   775	    (cancel-timer timer)
   776	    (remhash id superchat-work--armed)))
   777	
   778	(defun superchat-work-disarm-all ()
   779	  "Cancel every Emacs timer set to wake a record."
   780	  (maphash (lambda (_id timer) (cancel-timer timer)) superchat-work--armed)
   781	  (clrhash superchat-work--armed))
   782	
   783	(defun superchat-work--arm (id until)
   784	  (superchat-work--disarm id)
   785	  (puthash id (run-at-time (max 0 (- until (superchat-work--now))) nil
   786	                           #'superchat-work--wake-if-due id)
   787	           superchat-work--armed))
   788	
   789	(defun superchat-work--wake-if-due (id)
   790	  (remhash id superchat-work--armed)
   791	  (let ((record (superchat-work-get id)))
   792	    (when (and record (superchat-work--due-p record)
   793	               (<= (plist-get (plist-get record :waiting) :until) (superchat-work--now)))
   794	      (superchat-work--try-wake record))))
   795	
   796	(defun superchat-work--try-wake (record)
   797	  "Wake RECORD; return its View, or nil when the wake started nothing.
   798	A failed wake is tried again after `superchat-work-wake-retry-seconds', at
   799	most `superchat-work-wake-retry-limit' times in one Emacs."
   800	  (let ((id (plist-get record :id)))
   801	    (condition-case err
   802	        (prog1 (superchat-work-wake record)
   803	          (remhash id superchat-work--retries))
   804	      (error
   805	       (let ((failed (1+ (gethash id superchat-work--retries 0))))
   806	         (puthash id failed superchat-work--retries)
   807	         (message "superchat: work record %s was not taken up: %s"
   808	                  id (error-message-string err))
   809	         (when (<= failed superchat-work-wake-retry-limit)
   810	           (superchat-work--disarm id)
   811	           (puthash id (run-at-time superchat-work-wake-retry-seconds nil
   812	                                    #'superchat-work--wake-if-due id)
   813	                    superchat-work--armed)))
   814	       nil))))
   815	
   816	
   817	(defun superchat-work-wake (record)
   818	  "Take RECORD up again in a new conversation of its Workspace; return the View.
   819	Records `work.woken' first, naming the Workspace's main conversation; clears
   820	the wait; makes RECORD the new conversation's current record; sends the wake
   821	message.  When sending signals, the wait is put back, so the record is due
   822	again.  When that execution ends, a line is left in the main conversation."
   823	  (let* ((id (plist-get record :id))
   824	         (waiting (plist-get record :waiting))
   825	         (until (plist-get waiting :until))
   826	         (detail (plist-get waiting :detail))
   827	         (workspace (list :id (plist-get record :workspace-id)
   828	                          :root (plist-get record :workspace-root)))
   829	         (main (or (car (superchat-view-workspace-session-ids (plist-get workspace :id)))
   830	                   (plist-get record :session-id)))
   831	         (view (superchat-workspace-new-conversation workspace))
   832	         (session (buffer-local-value 'superchat--session-id view))
   833	         (sent nil))
   834	    (superchat-work--append session "work.woken"
   835	                            (format "Work record %s woken" id)
   836	                            (list :work-id id :until until :detail detail :main main))
   837	    (superchat-work--append session "work.waiting"
   838	                            (format "Work record %s no longer waits" id)
   839	                            (list :work-id id :for nil))
   840	    (superchat-work--append session "work.focused"
   841	                            (format "Current work record: %s" id)
   842	                            (list :work-id id))
   843	    (unwind-protect
   844	        (with-current-buffer view
   845	          (let ((inhibit-read-only t))
   846	            (goto-char (point-max))
   847	            (insert (format superchat-work-wake-prompt id)))
   848	          ;; The product speaks here, not the user.
   849	          (let ((superchat-automated-input t))
   850	            (superchat-send-input))
   851	          (setq sent t))
   852	      (unless sent
   853	        (superchat-work--restore-wait session id until detail)))
   854	    view))
   855	
   856	(defun superchat-work--run-of (session-id)
   857	  "The id of the first Run that started in SESSION-ID, by its Tape, or nil."
   858	  (cl-some (lambda (event)
   859	             (and (equal "run.started" (plist-get event :type))
   860	                  (plist-get event :run-id)))
   861	           (superchat-tape-replay-events session-id)))
   862	
   863	(defun superchat-work--run-ended-p (session-id run-id)
   864	  "Non-nil when RUN-ID has an ordinary end on SESSION-ID's Tape.
   865	A Run sealed as abandoned after a restart did not end; it was cut off."
   866	  (cl-some (lambda (event)
   867	             (and (equal run-id (plist-get event :run-id))
   868	                  (member (plist-get event :type)
   869	                          '("run.completed" "run.failed" "run.cancelled"))
   870	                  (not (eq t (plist-get (plist-get event :payload) :abandoned)))))
   871	           (superchat-tape-replay-events session-id)))
   872	
   873	(defun superchat-work--report-cut-off (record)
   874	  "Report RECORD's wakes whose execution an earlier Emacs never finished.
   875	Such an execution is on the Tape, this Emacs does not know it, and the main
   876	conversation was never told.  It is recorded as interrupted and not started
   877	again; return non-nil when something was reported."
   878	  (let (reported)
   879	    (dolist (wake (plist-get record :wakes))
   880	      (let* ((session (plist-get wake :session))
   881	             (main (plist-get wake :main))
   882	             (run (and main
   883	                       (not (member session (plist-get record :reported)))
   884	                       (superchat-work--run-of session))))
   885	        (when (and run (null (superchat-runtime-status run)))
   886	          (let* ((id (plist-get record :id))
   887	                 (ended (superchat-work--run-ended-p session run))
   888	                 (line (if ended
   889	                           (format "Work record %s was taken up at its time in conversation %s: %s."
   890	                                   id session (superchat-work-status-text record))
   891	                         (format "Work record %s was taken up at its time in conversation %s, and that execution was cut off when Emacs exited. It was not started again."
   892	                                 id session))))
   893	            (unless ended
   894	              (superchat-work--append
   895	               session "work.outcome" (format "Work record %s: interrupted" id)
   896	               (list :work-id id :run-id run :outcome "interrupted")))
   897	            (superchat-work--append main "work.reported" line
   898	                                    (list :work-id id :run-id run :conversation session))
   899	            (when-let* ((view (and (fboundp 'superchat-editor-workspace-buffer)
   900	                                   (superchat-editor-workspace-buffer main 'session-view)))
   901	                        ((buffer-live-p view)))
   902	              (ignore-errors
   903	                (let ((superchat-buffer-name (buffer-name view)))
   904	                  (with-current-buffer view
   905	                    (superchat--insert-persistent-system-message line)))))
   906	            (setq reported t)))))
   907	    reported))
   908	
   909	(defun superchat-work-wake-due ()
   910	  "Wake every record whose time has come; return the Views started.
   911	First an execution an earlier Emacs never finished is reported, and a wake
   912	cut off before it started anything is put back.  One record's wake failing
   913	does not stop the others."
   914	  (dolist (record (superchat-work-records))
   915	    (ignore-errors (superchat-work--report-cut-off record))
   916	    (superchat-work--restore-lost-wake record))
   917	  (let ((now (superchat-work--now)) views)
   918	    (dolist (record (superchat-work-records))
   919	      (when (and (superchat-work--due-p record)
   920	                 (<= (plist-get (plist-get record :waiting) :until) now))
   921	        (when-let* ((view (superchat-work--try-wake record)))
   922	          (push view views))))
   923	    (nreverse views)))
   924	
   925	
   926	(defun superchat-work-arm-all ()
   927	  "Wake the records whose time came while nothing was armed, arm the rest.
   928	A record whose wake just failed keeps the retry `superchat-work--try-wake'
   929	armed for it."
   930	  (superchat-work-disarm-all)
   931	  (clrhash superchat-work--retries)
   932	  (superchat-work-wake-due)
   933	  (let ((now (superchat-work--now)))
   934	    (dolist (record (superchat-work-records))
   935	      (when (and (superchat-work--due-p record)
   936	                 (> (plist-get (plist-get record :waiting) :until) now))
   937	        (superchat-work--arm (plist-get record :id)
   938	                             (plist-get (plist-get record :waiting) :until))))))
   939	
   940	
   941	(defun superchat-work--report-woken (run status)
   942	  "When the execution RUN of a woken record ends, note it in the main conversation.
   943	Which record RUN took up, and where to say so, is read from the `work.woken'
   944	fact of RUN's conversation, so it holds across an Emacs restart."
   945	  (let ((session (plist-get status :session-id)))
   946	    (dolist (record (superchat-work-records))
   947	      (when-let* ((wake (cl-find session (plist-get record :wakes)
   948	                                 :key (lambda (w) (plist-get w :session)) :test #'equal))
   949	                  (main (plist-get wake :main))
   950	                  ((not (member session (plist-get record :reported)))))
   951	        (let* ((id (plist-get record :id))
   952	               (line (format "Work record %s was taken up at its time in conversation %s: %s."
   953	                             id session (superchat-work-status-text record))))
   954	          (superchat-work--append main "work.reported" line
   955	                                  (list :work-id id :run-id run :conversation session))
   956	          (when-let* ((view (and (fboundp 'superchat-editor-workspace-buffer)
   957	                                 (superchat-editor-workspace-buffer main 'session-view)))
   958	                      ((buffer-live-p view)))
   959	            (ignore-errors
   960	              (let ((superchat-buffer-name (buffer-name view)))
   961	                (with-current-buffer view
   962	                  (superchat--insert-persistent-system-message line))))))))))
   963	
   964	;;;; The user's answer (slice 9) ------------------------------------------------------
   965	
   966	(defun superchat-work--on-user-input (session-id _text)
   967	  "The user spoke in SESSION-ID: its current record stops waiting for the user.
   968	The user's message is the signal the wait was registered for (K3), so the
   969	product clears it; the model does not have to remember to."
   970	  (when-let* ((id (superchat-work-current session-id))
   971	              (record (superchat-work-get id))
   972	              ((eq 'waiting-user (superchat-work-status record))))
   973	    (superchat-work--append session-id "work.waiting"
   974	                            (format "Work record %s: the user answered" id)
   975	                            (list :work-id id :for nil :answered t))))
   976	
