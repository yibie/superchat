   664	(defun superchat-work-mark-complete (id conclusion)
   665	  "Complete the open record ID yourself, with CONCLUSION (K11)."
   666	  (interactive
   667	   (let* ((open (cl-remove-if (lambda (r) (plist-get r :conclusion))
   668	                              (superchat-work-records)))
   669	          (choice (completing-read
   670	                   "Complete work record: "
   671	                   (mapcar (lambda (r) (format "%s  %s" (plist-get r :id) (plist-get r :goal)))
   672	                           open)
   673	                   nil t)))
   674	     (list (car (split-string choice)) (read-string "Conclusion: "))))
   675	  (let ((record (superchat-work--require id)))
   676	    (superchat-work-complete-by-user record conclusion)))
