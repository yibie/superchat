   183	(defun superchat-preset-apply (preset turn)
   184	  "Apply PRESET to TURN, mutating turn slots.
   185	Sets :preset, :target-model, :tools, and runs the :pre hook.
   186	Returns the modified TURN.
   187	
   188	Model precedence: an explicit per-turn @model (already parsed into
   189	TURN by the core pipeline) wins over the preset's model — the preset
   190	only fills the slot when it is still empty.
   191	
   192	For agent and plan presets, the skill body is the persona: it is
   193	prepended to TURN's system-prompt so it reaches the LLM as system
   194	context on every turn, not only on explicit skill invocation.
   195	Prompt-type presets keep their body out of the system prompt — for
   196	them the body is a prompt template handled by the skills layer."
   197	  (when preset
   198	    (setf (superchat-turn-preset turn) preset)
   199	    (when (and (superchat-preset-model preset)
   200	               (null (superchat-turn-target-model turn)))
   201	      (setf (superchat-turn-target-model turn)
   202	            (superchat-preset-model preset)))
   203	    (let ((tools (superchat-preset-tools preset)))
   204	      (when tools
   205	        ;; emit_plan is a plan-preset invariant: a stale or custom
   206	        ;; planning skill can declare a narrower surface, but without
   207	        ;; emit_plan the model cannot propose a reviewable plan at all.
   208	        ;; report_plan_progress is the twin execute-phase invariant:
   209	        ;; the plan prompt instructs the model to call it while the
   210	        ;; plan is active, so a tool-profiled request must carry it.
   211	        ;; Both live at this turn-shaping seam, not in the collector.
   212	        (let ((result
   213	               (if (superchat-preset-plan-p preset)
   214	                   (if (eq tools 'none)
   215	                       (list "emit_plan")
   216	                     (append tools (unless (member "emit_plan" tools)
   217	                                     (list "emit_plan"))))
   218	                 tools)))
   219	          (setf (superchat-turn-tools turn)
   220	                (if (and (not (eq result 'none))
   221	                         (superchat-preset--active-plan-p)
   222	                         (not (member "report_plan_progress" result)))
   223	                    (append result (list "report_plan_progress"))
   224	                  result)))))
   225	    (when (memq (superchat-preset-type preset) '(agent plan))
   226	      (let ((body (string-trim (or (superchat-preset-skill-body preset) ""))))
   227	        (unless (string-empty-p body)
   228	          (let ((existing (or (superchat-turn-system-prompt turn) "")))
   229	            (setf (superchat-turn-system-prompt turn)
   230	                  (if (string-empty-p existing)
   231	                      body
   232	                    (concat body "\n\n" existing)))))))
   233	    (superchat-preset-run-pre preset))
   234	  turn)
