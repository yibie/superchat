    55	(defun superchat-work--rows ()
    56	  "Every Work Record fact, oldest first, as (SESSION TYPE PAYLOAD)."
    57	  (let (out)
    58	    (dolist (row (superchat-db-tape-select
    59	                  "SELECT session_id, meta FROM tape
    60	                   WHERE kind = 'system' AND meta LIKE '%\"work.%'
    61	                   ORDER BY id ASC"))
    62	      (let* ((json-object-type 'alist)
    63	             (json-array-type 'list)
    64	             (json-key-type 'symbol)
    65	             (meta (ignore-errors (json-read-from-string (or (nth 1 row) ""))))
    66	             (type (alist-get 'event_type meta)))
    67	        (when (member type superchat-work-fact-types)
    68	          (push (list (nth 0 row) type (alist-get 'payload meta)) out))))
    69	    (nreverse out)))
