   186	(defun superchat-work-current (session-id)
   187	  "The id of SESSION-ID's current Work Record, or nil.
   188	That is the record of its last `work.focused' fact, while not completed."
   189	  (let (current)
   190	    (dolist (row (superchat-work--rows))
   191	      (cl-destructuring-bind (session type payload) row
   192	        (when (and (equal session session-id) (equal type "work.focused"))
   193	          (setq current (superchat-work--get payload 'work_id 'work-id)))))
   194	    (and current
   195	         (let ((record (superchat-work-get current)))
   196	           (and record (not (plist-get record :conclusion)) current)))))
