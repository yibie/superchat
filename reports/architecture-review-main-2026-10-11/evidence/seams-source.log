   764	(defun superchat--prepare-generated-request (instruction)
   765	  "Prepare an explicit producer INSTRUCTION without borrowing the user draft.
  1120	         ;; cases in `test/test-llm-backend.el').
  1121	         (owner (or (plist-get composed :transcript-owner)
  1122	                    (format "chat-owner-%08x" (random #x100000000))))
  1123	         (input-core (plist-get composed :input-core))
  1124	         (annotate (superchat--chat-annotate-spec composed))
  1125	         (extras
  1126	          (superchat-pipeline--plist-extend
  1127	           nil
  1128	           :input-core input-core
  1129	           ;; `superchat-runtime--turn-from-request' reads `:clean-input'
  1130	           ;; straight off the legacy Request to rebuild the private Turn
  1131	           ;; (falls back to `:user-message'/`:input' only when absent);
  1132	           ;; `--dispatch-to-runtime''s own fixed field list does not carry
  1133	           ;; it, so it must ride along as an extra or the reconstructed
  1134	           ;; Turn's `clean-input' silently reverts to the unstripped
  1135	           ;; `:input' value (caught by
  1136	           ;; `skill/mixed-input-uses-clean-prompt-and-echoes-skipped-command').
  1137	           :clean-input clean-input
  1138	           :workspace-id (plist-get composed :workspace-id)
  1139	           :workspace-root (plist-get composed :workspace-root)
  1140	           ;; A prepared (inspected) request's selection is the one its plan
  1141	           ;; saved, read by `superchat-pipeline--context-envelope'; the
  1142	           ;; legacy extra carries none for it.
  1143	           :context-envelope
  1144	           (unless (plist-get composed :chat-prepared-context)
  1145	             (plist-get composed :context-envelope))
  1146	           :lang (plist-get composed :lang)
  1147	           :accepted-function (plist-get composed :accepted-function)
  1148	           :owner-stop-function (plist-get composed :owner-stop-function)
  1149	           :actor-id (plist-get composed :actor-id)
  1150	           :correlation-id (plist-get composed :correlation-id)
  1151	           ;; Runtime's legacy submit path reads `:preset' to resolve
  1152	           ;; capability/topology naming and to pass the Preset object
  1153	           ;; itself to `superchat--llm-generate-answer' (max-tokens,
  1154	           ;; reasoning, temperature overrides); `composed :preset' is set
  1155	           ;; by `superchat--execute-llm-query' whenever the Turn carries
  1156	           ;; one but was never forwarded here (caught by
  1157	           ;; `test-send-input-inherits-active-preset-tools').
  1158	           :preset (plist-get composed :preset)
  1159	           :max-tokens (plist-get composed :max-tokens)
  1160	           :transcript-owner owner)))
  1161	    (superchat-pipeline--plist-extend
  1162	      (list :content content
  1163	            :surface 'chat
  1164	            ;; A message that named `>annotate' is still shown and recorded
  1165	            ;; in the conversation; its answer is also hung on the text.
