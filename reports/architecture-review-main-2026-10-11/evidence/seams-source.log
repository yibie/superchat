   465	(defun superchat-changes--unattended-run-p (session run)
   466	  "Non-nil when Superchat started RUN of SESSION at a time, not the user.
   467	Read from SESSION's Tape: a scheduled task records `timer.started' with the
   468	Run it began, and a woken Work Record's Run is the first one of a
   469	conversation that holds `work.woken'."
   470	  (let ((events (ignore-errors (superchat-tape-replay-events session)))
   471	        first woken started)
   472	    (dolist (event events)
   473	      (pcase (plist-get event :type)
   474	        ("run.started" (unless first (setq first (plist-get event :run-id))))
   475	        ("work.woken" (setq woken t))
   476	        ("timer.started"
   477	         (when (equal run (plist-get (plist-get event :payload) :run-id))
   478	           (setq started t)))))
   479	    (or started (and woken (equal run first)))))
