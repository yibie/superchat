   651	(defun superchat--preview-chat-prompt (turn &optional template)
   652	  "Assemble parsed TURN for an act request or its optional inspector.
   653	Return the display system, editable body and prepared context for sending.
   654	Use the same collection boundary and base fragments as the driver, without
   655	submitting.  Required content over budget signals before a plan is produced.
   656	`superchat--preview-origin-data' supplies the frozen origin snapshot."
   657	  (superchat--with-chat-execution-scope
   658	    (let* ((state (superchat-turn-state turn))
   659	           (env (list :content (or (superchat-turn-clean-input turn) "")
   660	                      :surface 'chat
   661	                      :session-id (superchat-turn-session-id turn)
   662	                      :target-model (superchat-turn-target-model turn)
   663	                      :system-prompt (superchat-turn-system-prompt turn)
   664	                      :context
   665	                      (append
   666	                       (list :chat-turn turn
   667	                             :chat-file-ref (plist-get state :file-ref)
   668	                             :chat-template template)
   669	                       (superchat--origin-context
   670	                        (list :emacs-origin-data superchat--preview-origin-data)))))
   671	           (collected
   672	            (superchat-pipeline--collect-context
   673	             env nil (superchat-turn-tools turn)))
   674	           (result
   675	            (superchat-prompt-assemble
   676	             (superchat-pipeline--context-fragments env collected)
   677	             (superchat-pipeline--budget (superchat-turn-target-model turn)))))
   678	      (list :system (or (plist-get result :system) "")
   679	            :prompt (plist-get (car (plist-get result :messages)) :content)
   680	            :prepared-context
   681	            (list :prompt
   682	                  (plist-get (car (plist-get result :messages)) :content)
   683	                  :system-fragments
   684	                  (cl-remove-if-not
   685	                   (lambda (fragment)
   686	                     (memq (plist-get fragment :slot) '(system instruction)))
   687	                   collected)
   688	                  ;; History refitting during assembly fixes this selection.
   689	                  :context-envelope
   690	                  (copy-tree (plist-get (superchat-turn-state turn)
   691	                                        :context-envelope)))))))
   692	
   693	(defun superchat-build-request-plan (input &optional session-id origin)
   694	  "Build a dry-run request plan for INPUT, SESSION-ID, and ORIGIN.
   695	No backend call or post-turn side effect occurs.  The first slice
   696	supports plain requests and active command mode; slash commands,
   697	skills, workflows, and agent presets continue to use the chat buffer.
   698	
   699	This is the one moment a request prepared here captures its source: ORIGIN
   700	is this call's own source (the act entry), otherwise the View's associated
   701	editing source is read.  The captured snapshot is frozen on the plan, so the
   702	preview, the inspector's confirmed send and the submitted request all speak
   703	about the same instant -- the source buffer may change afterwards and the
   704	request still reports what was true when it was prepared.  INPUT itself
   705	stays the user's own text; the facts travel as request data, never appended
   706	to what the user typed and never as instructions."
   707	  (let* ((raw-input (string-trim (or input "")))
   708	         (full-input raw-input)
   709	         (turn (superchat-turn-new full-input session-id))
   710	         (view (current-buffer))
   711	         (origin-data (superchat--resolve-origin-data view origin)))
   712	    (when (string-empty-p (superchat-turn-inbound turn))
   713	      (user-error "Request input is empty"))
   714	    (setf (superchat-turn-origin turn) origin)
   715	    (superchat--attach-turn-memories turn full-input session-id)
   716	    (let* ((prepared (superchat--with-chat-execution-scope
   717	                       (superchat-core-prepare-turn turn)))
   718	           (skill (superchat-turn-skill prepared))
   719	           (command (superchat-turn-command prepared))
   720	           (superchat-execution-scope
   721	            (if (and (null skill)
   722	                     (boundp 'superchat--active-preset)
   723	                     superchat--active-preset)
   724	                (superchat--apply-active-preset prepared)
   725	              superchat-execution-scope)))
   726	      (when (or skill command
   727	                (and (superchat-turn-preset prepared)
   728	                     (superchat-preset-agent-p
   729	                      (superchat-turn-preset prepared))))
   730	        (user-error
   731	         "Request inspection currently supports plain and prompt-mode turns"))
   732	      (let* ((template (when superchat--current-command
   733	                         (superchat--lookup-command-template
   734	                          superchat--current-command)))
   735	             (plan (superchat--request-plan-from-turn
   736	                    prepared template
   737	                    (superchat-turn-target-model prepared)))
   738	             ;; Capture once, including history and attachments.  Sending
   739	             ;; reuses the system fragments and the exact final body instead
   740	             ;; of collecting into an already assembled body a second time.
   741	             (preview (let ((superchat--preview-origin-data origin-data))
   742	                        (superchat--preview-chat-prompt prepared template))))
   743	        ;; The body is the inspector's exact editable text.  The assembled
   744	        ;; system is display-only: sending it as the base system would add
   745	        ;; every system collector a second time.  Keep :system-prompt as the
   746	        ;; original Turn/Preset contribution for ordinary pipeline assembly.
   747	        (setq plan (plist-put plan :prompt (plist-get preview :prompt)))
   748	        (setq plan (plist-put plan :preview-system-prompt
   749	                              (plist-get preview :system)))
   750	        (setq plan (plist-put plan :chat-prepared-context
   751	                              (plist-get preview :prepared-context)))
   752	        (setq plan (plist-put plan :input raw-input))
   753	        (setq plan (plist-put plan :clean-input raw-input))
   754	        (setq plan (plist-put plan :user-message raw-input))
   755	        ;; The frozen source snapshot the preview above was assembled with.
   756	        ;; The send that follows this inspection reuses it verbatim rather
   757	        ;; than capturing again.
   758	        (setq plan (plist-put plan :emacs-origin-data origin-data))
   759	        (setq plan
   760	              (plist-put plan :consume-pending-memories
   761	                         (and superchat--pending-recalled-memories t)))
   762	        plan))))
