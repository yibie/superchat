(ert-deftest r3-domain/legacy-focus-leaks-through-collector-and-clears-wait ()
  (wrec--with '((:text "PLAIN B ANSWER")) (p q)
    (let* ((sa (hm--session (wrec--view p)))
           (id (superchat-work-start sa "R3-A-PRIVATE-GOAL"))
           (b (wrec--view q)) (sb (hm--session b)))
      (superchat-work-wait sa id "user" "R3-A-PRIVATE-QUESTION")
      ;; Real row shape from the pre-b768713e tool path; not an invented object.
      (superchat-work--append sb "work.focused" "legacy focus" (list :work-id id))
      (let ((superchat--tool-execution-context (list :session-id sb)))
        (should (string-match-p "another workspace" (superchat-work-tool "read" id))))
      (hm--turn b "An unrelated question in B")
      (should (string-match-p "R3-A-PRIVATE-GOAL" (prin1-to-string hm--wires)))
      (should-not (plist-get (superchat-work-get id) :waiting))
      (should (equal '("continuable") (plist-get (superchat-work-get id) :outcomes)))
      (princ "R3-01 OBSERVED: tool read refused; B's ordinary request still receives A's goal; B's user input clears A's user wait; B's completed Run appends an outcome to A.\n"))))

(ert-deftest r3-domain/post-terminal-work-write-failure-is-silent ()
  (wrec--with '((:text "DONE")) (p)
    (let* ((view (wrec--view p)) (session (hm--session view))
           (id (superchat-work-start session "R3-OUTCOME"))
           (append-event (symbol-function 'superchat-tape-append-event))
           (hits 0) (fault-count (length superchat-event-faults)))
      (cl-letf (((symbol-function 'superchat-tape-append-event)
                 (lambda (event &rest args)
                   (if (equal "work.outcome" (plist-get event :type))
                       (progn (cl-incf hits) (error "R3 injected outcome storage unavailable"))
                     (apply append-event event args)))))
        (hm--turn view "Finish this step"))
      (should (= hits 1))
      (should (= 1 (length (hm--events session "run.completed"))))
      (should-not (plist-get (superchat-work-get id) :outcomes))
      (should (= fault-count (length superchat-event-faults)))
      ;; The actual domain's recovery scan does not repair an ordinary Run.
      (superchat-work-arm-all)
      (should-not (plist-get (superchat-work-get id) :outcomes))
      (princ "R3-02 OBSERVED: work.outcome append raised once after terminal; run.completed=1; outcomes=0; fault ring unchanged; arm-all does not recover the outcome.\n"))))

(ert-deftest r3-domain/remount-resets-retry-budget-and-wait ()
  (wtimer--with nil (p)
    (let* ((session (cdr (tsf--task p "R3-RETRY")))
           (superchat-timer-retry-limit 0)
           (tries 0))
      (unwind-protect
          (cl-letf (((symbol-function 'superchat-send-input)
                     (lambda () (cl-incf tries) (error "R3 unavailable"))))
            (superchat-timer-catch-up)
            (should (= tries 1))
            (superchat-timer-retry-tasks)
            (should (= tries 1))
            (superchat-plugin-unmount 'timers)
            (superchat-plugin-mount 'timers)
            (should (smoke--wait (lambda () (= tries 2)) 2))
            (should (= 2 (tsf--count session "timer.sending")))
            (princ (format "R3-03 OBSERVED: retry-limit=0; ordinary rescan stays at 1 attempt; unmount/remount in same Emacs at same virtual time causes %d attempts.\n" tries)))
        (unless (superchat-plugin-row-active-p 'timers) (superchat-plugin-mount 'timers))))))

(ert-deftest r3-domain/cached-tool-bodies-refuse-when-capability-is-off ()
  (wrec--with nil (p)
    (let* ((view (wrec--view p)) (session (hm--session view))
           (superchat--tool-execution-context (list :session-id session))
           (work (symbol-function 'superchat-work-tool))
           (timer (symbol-function 'superchat-timer-tool-create)))
      (unwind-protect
          (progn
            (superchat-plugin-unmount 'work-records)
            (superchat-plugin-unmount 'timers)
            (should (string-match-p "turned off" (funcall work "start" nil "G" "P" nil "R" "time" "D" nil nil 60)))
            (should-not (superchat-work-current session))
            (should (string-match-p "no timer was set" (funcall timer "T" "task" 60)))
            (should-not (superchat-timer-list))
            (princ "GUARD: cached callable bodies refuse time wait and timer creation after unmount; no work or timer created.\n"))
        (superchat-plugin-mount 'work-records)
        (superchat-plugin-mount 'timers)))))

(ert-run-tests-batch-and-exit "^r3-domain/")
