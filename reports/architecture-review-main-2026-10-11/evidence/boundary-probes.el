;;; boundary-probes.el --- Round 3 retry and visibility boundary checks -*- lexical-binding: t; -*-
(load (expand-file-name "scripts/timer-start-fault-regression.el" default-directory) nil t)

(ert-deftest r3-boundary/remount-also-skips-failure-wait ()
  (wtimer--with nil (p)
    (let* ((session (cdr (tsf--task p "R3-WAIT")))
           (superchat-timer-retry-limit 2)
           (clock wtimer--now) (tries 0))
      (unwind-protect
          (cl-letf (((symbol-function 'superchat-send-input)
                     (lambda () (cl-incf tries) (error "R3 start unavailable"))))
            (superchat-timer-catch-up)
            (should (= tries 1))
            (superchat-timer-retry-tasks)
            (should (= tries 1))
            (superchat-plugin-unmount 'timers)
            (superchat-plugin-mount 'timers)
            (should (smoke--wait (lambda () (= tries 2)) 2))
            (should (= clock wtimer--now))
            (should (= 2 (tsf--count session "timer.sending")))
            (princ "R3-03 WAIT: retry-limit=2, wait=300s; ordinary scan waits, remount sends again at virtual elapsed=0s.\n"))
        (unless (superchat-plugin-row-active-p 'timers) (superchat-plugin-mount 'timers))))))

(ert-deftest r3-boundary/no-common-view-for-due-and-unconfirmed-tasks ()
  (wtimer--with nil (p)
    (let* ((pair (tsf--task p "R3-DUE-UNSTARTED"))
           (view (car pair)) (session (cdr pair))
           (superchat-changes--notices nil)
           (superchat--tool-execution-context (list :session-id session)))
      (tsf--send-failing (superchat-timer-catch-up))
      (let* ((task (car (superchat-timer-unstarted-tasks)))
             (id (plist-get task :id))
             (text (superchat-timer-tool-list)))
        (should task)
        (should (string-match-p "No pending timers" text))
        (should (string-match-p "R3-DUE-UNSTARTED" text))
        (should-not (string-match-p (regexp-quote id) text))
        (should-not (superchat-work--list-entries))
        (should-not (superchat-changes--notices-entries))
        ;; An unrelated real Run after sending triggers the actual ambiguous
        ;; classification; do not manually manufacture timer.unconfirmed.
        (setq smoke--script '((:text "Unrelated answer")))
        (hm--turn view "Another question, unrelated to the timer")
        (superchat-timer-retry-tasks)
        (should (= 1 (tsf--count session "timer.unconfirmed")))
        (should-not (superchat-timer-unstarted-tasks))
        (should (equal text (superchat-timer-tool-list)))
        (should-not (superchat-changes--notices-entries))
        (princ "OPEN-C OBSERVED: due-unstarted task absent from work/notice lists; timer_list shows only fired text without id/start-state. Actual unconfirmed transition changes neither tool list nor notices (conversation receives explanation). This proves a fragmented view, not a contracted unified-screen defect.\n")))))

(ert-run-tests-batch-and-exit "^r3-boundary/")
