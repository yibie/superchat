;;; skill-once-regression.el --- an agent skill named in the middle applies to one message -*- lexical-binding: t; -*-

;;; Commentary:
;; Offline coverage for
;; docs/decisions/accepted/2026-10-10-an-agent-skill-for-one-message.md.
;; Every test sends real messages through a conversation and reads what the
;; scripted model received; it borrows the request-context suite's Session,
;; scripted model and request reader.  No real model and no protected
;; regression set loads.
;;
;; Run with the canonical smoke dependency load paths, then:
;;   -l scripts/skill-once-regression.el
;;   --eval '(ert-run-tests-batch-and-exit "^skill-once/")'

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'subr-x)
(defvar smoke-library-only)
(setq smoke-library-only t)
(load (expand-file-name "m5-request-context-regression.el"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t)
(require 'superchat-skills)

(defvar superchat-automated-input)
(defvar superchat--active-preset)

(defun sko--skill (name type &optional extra)
  "Write a skill NAME of TYPE whose text is SKO_PERSONA_NAME.
EXTRA is more frontmatter lines.  It may use `read_buffer' only."
  (make-directory superchat-skills-directory t)
  (with-temp-file (expand-file-name (concat name ".md")
                                    superchat-skills-directory)
    (insert "---\nname: " name "\ntype: " type "\n" (or extra "")
            "tools: [read_buffer]\n---\nSKO_PERSONA_" name "\n")))

(defun sko--active (view)
  "Return the name of VIEW's active preset, or nil."
  (with-current-buffer view
    (and superchat--active-preset
         (superchat-preset-name superchat--active-preset))))

(defun sko--activations (view)
  "Return how many times VIEW's conversation recorded a change of capability."
  (cl-count "capability.activated"
            (superchat-tape-replay-events
             (buffer-local-value 'superchat--session-id view))
            :key (lambda (event) (plist-get event :type))
            :test #'equal))

(defun sko--system (request)
  "Return REQUEST's system text."
  (or (plist-get request :system) ""))

(defun sko--tools ()
  "Return the tool names of the newest request the model received."
  (plist-get (car smoke--requests) :tools))

(ert-deftest skill-once/an-agent-skill-in-the-middle-shapes-that-message-only ()
  (m5rc--fixture '((:text "one") (:text "two"))
    (let ((view (m5rc--open (m5rc--source)))
          (superchat-automated-input nil))
      (sko--skill "sko-agent" "agent")
      (let ((before (sko--activations view)))
        (smoke--send view "SKO_BEFORE >sko-agent SKO_AFTER")
        (let ((request (m5rc--settle 1)))
          ;; This message goes out as the skill: its text, its tools.
          (should (= 1 (m5rc--count "SKO_PERSONA_sko-agent" (sko--system request))))
          (should (equal '("read_buffer") (sko--tools)))
          (should (= 1 (m5rc--count "SKO_BEFORE SKO_AFTER"
                                    (car (last (plist-get request :users)))))))
        ;; The conversation did not change: neither what the View holds nor
        ;; what its record says.
        (should-not (sko--active view))
        (should (= before (sko--activations view)))
        (smoke--send view "SKO_NEXT")
        (let ((request (m5rc--settle 2)))
          (should (= 0 (m5rc--count "SKO_PERSONA" (sko--system request))))
          (should (member "edit_buffer" (sko--tools))))))))

(ert-deftest skill-once/an-agent-skill-with-its-own-capability-also-runs-once ()
  ;; Runtime refuses a request whose capability differs from its profile's.
  (m5rc--fixture '((:text "one") (:text "two"))
    (let ((view (m5rc--open (m5rc--source)))
          (superchat-automated-input nil))
      (sko--skill "sko-cap" "agent" "capability: sko-capability\n")
      (let ((before (sko--activations view)))
        (smoke--send view "SKO_BEFORE >sko-cap SKO_AFTER")
        (let ((request (m5rc--settle 1)))
          (should (= 1 (m5rc--count "SKO_PERSONA_sko-cap" (sko--system request))))
          (should (equal '("read_buffer") (sko--tools))))
        (should-not (sko--active view))
        (should (= before (sko--activations view)))
        (smoke--send view "SKO_NEXT")
        (let ((request (m5rc--settle 2)))
          (should (= 0 (m5rc--count "SKO_PERSONA" (sko--system request)))))))))

(ert-deftest skill-once/an-agent-skill-at-the-start-still-switches-the-conversation ()
        (should (= 1 (length (superchat-work-wake-due))))
        (wrec--settled)
        (let ((record (superchat-work-get id)))
          (should (equal "WOKEN-PROGRESS" (plist-get record :progress)))
          (should (equal "WOKEN-CONCLUSION" (plist-get record :conclusion))))))))

(ert-deftest object-scope/a-sub-agent-is-told-of-its-record-and-cannot-change-it ()
  "A sub-agent is given a snapshot of the record and told it cannot change it
\(K14); its conversation is of no Workspace, so the tool refuses it too.  What
the product writes when the sub-agent hands back is not the model's way in."
  (wrec--with (list (wrec--call '(action . "start") '(goal . "OSCOPE-SUB-GOAL"))
                    '(:tool-uses (("delegate_to_subagent" (preset . "researcher")
                                   (task . "SUB-TASK-MARKER look into it"))))
                    '(:text "SUB-REPORT found three things")
                    '(:text "done"))
      (p)
    (setq superchat-llm-tool-names
          (append superchat-llm-tool-names '("delegate_to_subagent")))
    (let* ((view (wrec--view p))
           (session (hm--session view)))
      (hm--turn view "start it and delegate the research")
      (let* ((id (superchat-work-current session))
             (task (car (plist-get (superchat-work-get id) :tasks)))
             (child (plist-get task :conversation)))
        ;; The product recorded the delegated task under the record.
        (should (equal "completed" (plist-get task :status)))
        (should (string-match-p "SUB-REPORT" (plist-get task :report)))
        (should (stringp child))
        (should-not (equal child session))
        ;; The sub-agent was shown the record ...
        (should (string-match-p "OSCOPE-SUB-GOAL"
                                (hm--text (car (wrec--subagent-wire)))))
        ;; ... and its own tool call on it is refused, writing nothing.
        (let ((rows (oscope--work-rows)))
          (oscope--as child
            (should (string-match-p oscope--refusal
                                    (superchat-work-tool "update" id nil "FROM-CHILD"))))
          (should (= rows (oscope--work-rows))))))))

(ert-deftest object-scope/a-conversation-of-no-workspace-reaches-no-record ()
  (wrec--with nil (p)
    (let* ((sa (hm--session (wrec--view p)))
           (id (superchat-work-start sa "OSCOPE-PRIVATE-GOAL"))
           (temporary (hm--session (smoke--open-chat)))
           (rows (oscope--work-rows)))
      (should-not (superchat-work--workspace temporary))
      (oscope--as temporary
        (dolist (answer (list (superchat-work-tool "read" id)
                              (superchat-work-tool "done" id nil nil nil nil nil nil "C")))
          (should (string-match-p oscope--refusal answer))
          (should-not (string-match-p "OSCOPE-PRIVATE-GOAL" answer))))
      (should (= rows (oscope--work-rows))))))

(ert-deftest object-scope/a-record-focused-before-the-check-is-refused-the-same-way ()
  "A Tape written before this check may name another Workspace's record current."
  (wrec--with nil (p q)
    (let* ((sa (hm--session (wrec--view p)))
           (id (superchat-work-start sa "OSCOPE-PRIVATE-GOAL"))
           (sq (hm--session (wrec--view q))))
      (superchat-work--append sq "work.focused" "legacy focus" (list :work-id id))
      (should (equal id (superchat-work-current sq)))
      (let ((rows (oscope--work-rows)))
        (oscope--as sq
          (should (string-match-p oscope--refusal
                                  (superchat-work-tool "update" nil nil "P"))))
        (should (= rows (oscope--work-rows)))))))

(ert-deftest object-scope/the-users-list-still-shows-every-workspaces-records ()
  "Guard: what the user opens is not the model's view."
  (wrec--with nil (p q)
    (let* ((sa (hm--session (wrec--view p)))
           (id (superchat-work-start sa "OSCOPE-PRIVATE-GOAL"))
           (b (wrec--view q)))
      (with-current-buffer b
        (should (assoc id (superchat-work--list-entries)))
        ;; And the user's own command completes it from anywhere.
        (superchat-work-complete-by-user (superchat-work--require id) "CLOSED-BY-USER"))
      (should (equal "CLOSED-BY-USER" (plist-get (superchat-work-get id) :conclusion))))))

