484  (defun superchat-work-tool (action &optional id goal progress blocked resume
 485                                     wait_for detail conclusion follows
 486                                     in_minutes at)
 487    "The `work_record' tool: ACTION is start, update, wait, done or read."
 488    (condition-case err
 489        (let* ((session (superchat-work--tool-session))
 490               (id (if (and (stringp id) (not (string-empty-p id)))
 491                       id
 492                     (superchat-work-current session))))
 493          (pcase action
 494            ("start"
 495             (let ((new (superchat-work-start session goal follows)))
 496               (format "Started %s; it is this conversation's current work record."
 497                       new)))
 498            ("update"
 499             (unless id (error "No current work record; start one or give its id"))
 500             (when (or progress blocked resume)
 501               (superchat-work-update session id progress blocked resume))
 502             ;; A wait given with an update is registered too, never dropped: in
 503             ;; the real task T4W the model put wait_for and in_minutes on an
 504             ;; update and believed the wait was registered.
 505             (when (and (stringp wait_for) (not (string-empty-p wait_for)))
 506               (superchat-work-wait
 507                session id wait_for detail
 508                (cond ((and (stringp at) (not (string-empty-p at)))
 509                       (superchat-timer-parse-time at))
 510                      ((numberp in_minutes) (+ (superchat-work--now) (* 60 in_minutes))))))
 511             (unless (or progress blocked resume
 512                         (and (stringp wait_for) (not (string-empty-p wait_for))))
 513               (error "Say how far it got, why the next step waits, or where to pick it up"))
 514             (superchat-work-render (superchat-work-get id)))
