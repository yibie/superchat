   977	;;;; The end of an execution (K3, K7) -----------------------------------------
   978	
   979	(defun superchat-work--facts-in-run (record-id run-id)
   980	  "The Work Record facts of RECORD-ID written during RUN-ID, as (TYPE . PAYLOAD)."
   981	  (delq nil
   982	        (mapcar (lambda (row)
   983	                  (cl-destructuring-bind (_session type payload) row
   984	                    (and (equal record-id (superchat-work--get payload 'work_id 'work-id))
   985	                         (equal run-id (superchat-work--get payload 'run_id 'run-id))
   986	                         (cons type payload))))
   987	                (superchat-work--rows))))
   988	
   989	(defun superchat-work-outcome (record-id run-id run-status)
   990	  "How RUN-ID, ended with RUN-STATUS, left RECORD-ID, from facts alone.
   991	`completed' when it completed the record; `waiting' when it registered a wait
   992	still standing; `failed' when the Run failed; otherwise `continuable'.  The
   993	answer's words are never read (K7)."
   994	  (let* ((facts (superchat-work--facts-in-run record-id run-id))
   995	         (record (superchat-work-get record-id)))
   996	    (cond ((assoc "work.completed" facts) 'completed)
   997	          ((and (assoc "work.waiting" facts) (plist-get record :waiting)) 'waiting)
   998	          ((not (eq run-status 'completed)) 'failed)
   999	          (t 'continuable))))
  1000	
  1001	(defun superchat-work--on-turn-completed (_run status)
  1002	  "At the end of an execution, attach its facts and its outcome to the record.
  1003	The record is the conversation's current one, or one this execution completed."
  1004	  (when (and (listp status)
  1005	             (fboundp 'superchat-runtime--terminal-p)
  1006	             (superchat-runtime--terminal-p (plist-get status :status)))
  1007	    (let* ((session (plist-get status :session-id))
  1008	           (run (plist-get status :run-id))
  1009	           (ids (delete-dups
  1010	                 (delq nil
  1011	                       (cons (superchat-work-current session)
  1012	                             (mapcar (lambda (row)
  1013	                                       (cl-destructuring-bind (s type payload) row
  1014	                                         (and (equal s session)
  1015	                                              (equal type "work.completed")
  1016	                                              (equal run (superchat-work--get payload 'run_id 'run-id))
  1017	                                              (superchat-work--get payload 'work_id 'work-id))))
  1018	                                     (superchat-work--rows)))))))
  1019	      (dolist (id ids)
  1020	        (ignore-errors
  1021	          (let ((rows (and (fboundp 'superchat-changes-candidates)
  1022	                           (superchat-changes-candidates session run))))
  1023	            (when rows
  1024	              (superchat-work--append
  1025	               session "work.facts" (format "Work record %s: what the execution changed" id)
  1026	               (list :work-id id :run-id run
  1027	                     :buffers (vconcat (mapcar (lambda (r) (plist-get r :name)) rows))
  1028	                     :files (vconcat (delq nil (mapcar (lambda (r) (plist-get r :file)) rows)))
  1029	                     ;; K13: in a jj repository, the change these edits sit in.
  1030	                     :jj-change (superchat-work-jj-change
  1031	                                 (plist-get (superchat-work-get id) :workspace-root))))))
  1032	          (let ((outcome (superchat-work-outcome id run (plist-get status :status))))
  1033	            (superchat-work--append
  1034	             session "work.outcome" (format "Work record %s: %s" id outcome)
  1035	             (list :work-id id :run-id run :outcome (symbol-name outcome))))))
  1036	      (ignore-errors (superchat-work--report-woken run status)))))
