344  (defun superchat-timer--retry-later (seconds)
 345    "Try the unstarted tasks again in SECONDS, unless that is already set."
 346    (unless (timerp superchat-timer--retry-timer)
 347      (setq superchat-timer--retry-timer
 348            (run-at-time seconds nil
 349                         (lambda ()
 350                           (setq superchat-timer--retry-timer nil)
 351                           (superchat-timer-retry-tasks))))))
 352  
 353  (defun superchat-timer--try-task (session-id timer-id occurrence text)
 354    "Start the task and return its Run id, or nil when no execution began.
 355  A busy conversation is tried again after `superchat-timer-busy-retry-seconds'
 356  without limit; a failed start after `superchat-timer-retry-seconds', at most
 357  `superchat-timer-retry-limit' times in one Emacs."
 358    (let* ((key (cons timer-id occurrence))
 359           (run (condition-case err
 360                    (superchat-timer--start-task session-id timer-id occurrence text)
 361                  (error (message "superchat: scheduled task %s was not started: %s"
 362                                  timer-id (error-message-string err))
 363                         nil))))
 364      (cond ((stringp run) (remhash key superchat-timer--retries) run)
 365            ((eq run 'busy)
 366             (superchat-timer--retry-later superchat-timer-busy-retry-seconds)
 367             nil)
 368            (t (let ((failed (1+ (gethash key superchat-timer--retries 0))))
 369                 (puthash key failed superchat-timer--retries)
 370                 (when (<= failed superchat-timer-retry-limit)
 371                   (superchat-timer--retry-later superchat-timer-retry-seconds)))
 372               nil))))
