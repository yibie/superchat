  1038	(superchat-define-plugin work-records
  1039	  :doc "Work Records: at the end of every execution, the product attaches what
  1040	it changed to the conversation's current record and decides how it stands."
  1041	  :apply
  1042	  (lambda (scope _config)
  1043	    (superchat-on scope 'turn-completed 'work-outcome
  1044	                  #'superchat-work--on-turn-completed)
  1045	    (add-hook 'superchat-user-input-functions #'superchat-work--on-user-input)
  1046	    (superchat-scope-effect
  1047	     scope (lambda ()
  1048	             (remove-hook 'superchat-user-input-functions
  1049	                          #'superchat-work--on-user-input)))
  1050	    ;; After loading finishes, so a missed wake never starts mid-`require'.
  1051	    (let ((start (run-at-time 0 nil #'superchat-work-arm-all)))
  1052	      (superchat-scope-effect scope
  1053	                              (lambda ()
  1054	                                (cancel-timer start)
  1055	                                (superchat-work-disarm-all))))))
