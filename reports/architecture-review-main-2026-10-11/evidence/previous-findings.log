   794	(defun superchat-changes-notices ()
   795	  "List the executions Superchat started by itself that have ended.
   796	A scheduled task or a Work Record that woke leaves one notice when its
   797	execution ends, however it ended; the mode line shows how many are pending."
   798	  (interactive)
   799	  (let ((buffer (get-buffer-create superchat-changes-notices-buffer-name)))
   800	    (with-current-buffer buffer
   801	      (superchat-changes-notices-mode)
   802	      (tabulated-list-print))
   803	    (pop-to-buffer buffer)
   804	    buffer))
