313  (defun superchat-timer--start-task (session-id timer-id occurrence text)
 314    "Start the model on TEXT in the conversation SESSION-ID; return the Run id.
 315  Return `busy', sending nothing, while an execution runs there: the message
 316  would only be queued in memory.  Otherwise record `timer.sending', send, and
 317  record `timer.started' with the Run that began; nil when none began."
 318    (if (superchat-timer--session-busy-p session-id)
 319        'busy
 320      (let ((view (or (superchat-timer--live-view session-id)
 321                      (and (fboundp 'superchat--render-session-view)
 322                           (superchat--render-session-view session-id)))))
 323        (when (buffer-live-p view)
 324          (with-current-buffer view
 325            (let ((before superchat--active-run-id))
 326              (superchat-timer--fact session-id "timer.sending" timer-id occurrence)
 327              (let ((inhibit-read-only t)
 328                    (start (copy-marker (point-max))))
 329                (goto-char (point-max))
 330                (insert text)
 331                (condition-case err
 332                    ;; The timer speaks here, not the user.
 333                    (let ((superchat-automated-input t))
 334                      (superchat-send-input))
 335                  ;; A failed send must not leave the text for the next try.
 336                  (error (when (<= start (point-max))
 337                           (delete-region start (point-max)))
 338                         (signal (car err) (cdr err)))))
 339              (let ((run superchat--active-run-id))
 340                (when (and (stringp run) (not (equal run before)))
 341                  (superchat-timer--note-started session-id timer-id occurrence run)
 342                  run))))))))
