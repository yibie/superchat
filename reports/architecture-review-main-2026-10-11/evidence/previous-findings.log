   806	(defvar superchat-timer-started-functions)
   807	(declare-function superchat-runtime-status "superchat-runtime" (run-id))
   808	
   809	(defun superchat-changes--note-started-late (session run)
   810	  "Leave RUN's notice when it ended before it was on record as a task's.
   811	A scheduled task's `timer.started' is written after the send returns; an
   812	execution that ended inside that send was not yet known to be Superchat's
   813	own when it ended.  Called with SESSION and RUN once the fact is written."
   814	  (when-let* ((status (and (fboundp 'superchat-runtime-status)
   815	                           (superchat-runtime-status run))))
   816	    (superchat-changes--note-unattended
   817	     nil (append (list :session-id session :run-id run) status))))
